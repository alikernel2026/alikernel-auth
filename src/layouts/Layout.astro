---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - علي كيرنل</title>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon-96x96.png?raw=true' rel='icon' sizes='96x96' type='image/png'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.svg?raw=true' rel='icon' type='image/svg+xml'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.ico?raw=true' rel='shortcut icon'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/apple-touch-icon.png?raw=true' rel='apple-touch-icon' sizes='180x180'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/site.webmanifest?raw=true' rel='manifest'/>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">

    <style is:global>
        :root { 
            --fontBody: 'Noto Sans', 'Tajawal', sans-serif; 
            --fontHead: 'Noto Sans', 'Tajawal', sans-serif; 
            --sideBd-line: 1px; 
            --content-maxWidth: 1024px; 
            --contentPadding: 22px; 
        }

        /* إصلاح تشوه الخطوط المظهر بالفيديو */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased; /* لجعل الخط ناعم مثل بلوجر */
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
        }

        body {
            font-family: var(--fontBody);
            background-color: var(--themeBg);
            color: var(--themeC);
            line-height: 1.6;
            font-weight: 400; /* الوزن الافتراضي لمنع التسميك التلقائي */
        }

        /* === الوضع المظلم === */
        body {
            --themeBg: #100f10; --postBg: #1b1b1b; --headerBg: #1b1b1b; --contentBg-sec: #252526;
            --themeLink: #94f27f; --themeC: #d9e2f0; --themeC-alt: #a0a0a0; --sideBd-color: #3a3c3d;
            --alikernelBg: #ffffff; --alikernelC: #171717; --logoFg: #000000;
        }

        /* === الوضع النهاري === */
        body[data-theme="light"] {
            --themeBg: #f6f8fa; --postBg: #ffffff; --headerBg: #ffffff; --contentBg-sec: #f6f8fa;
            --themeLink: #1976d2; --themeC: #0e2045; --themeC-alt: #666666; --sideBd-color: #d2d3d7;
            --alikernelBg: #171717; --alikernelC: #ffffff; --logoFg: #ffffff;
        }

        .site-header { 
            position: sticky; top: 0; z-index: 100; height: 65px; display: flex; align-items: center; justify-content: center;
            border-bottom: var(--sideBd-line) solid var(--sideBd-color); background-color: rgba(255,255,255,0.4); 
            -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); 
        }
        body[data-theme="dark"] .site-header { background-color: rgba(27, 27, 27, 0.4); }

        .header-content { width: 100%; max-width: var(--content-maxWidth); padding-inline: var(--contentPadding); display: flex; align-items: center; gap: 12px; }

        /* تعديل "علي كيرنل" في الهيدر ليتطابق مع الفيديو */
        .header-logo-link { display: flex; align-items: center; font-weight: 700; font-size: 18px; color: var(--themeC); letter-spacing: -0.5px; }
        .header-logo-icon { width: 32px; height: 32px; margin-inline-end: 12px; flex-shrink: 0; }
        .ak-logo-bg { fill: var(--alikernelBg); }
        .ak-logo-fg { fill: var(--logoFg); }

        .page-content { flex: 1; }
        .static-page-content { width: 100%; max-width: var(--content-maxWidth); margin: auto; padding: var(--contentPadding); }

        /* الفوتر: إصلاح المسافة بين "الخصوصية" و "الشروط" المظهرة بالفيديو */
        .site-footer { border-top: var(--sideBd-line) solid var(--sideBd-color); padding-block: 25px; background-color: var(--headerBg); margin-top: auto; }
        .footer-content { max-width: var(--content-maxWidth); margin: auto; padding-inline: var(--contentPadding); display: flex; justify-content: space-between; align-items: center; }
        
        .footer-logo-section { display: flex; align-items: center; gap: 20px; } /* زيادة المسافة (Gap) لفك الالتصاق */
        .footer-logo-link { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; color: var(--themeC); }
        .footer-logo-icon { width: 28px; height: 28px; }
        
        /* روابط الخصوصية والشروط */
        .footer-logo-section a:not(.footer-logo-link) { 
            font-size: 12px; font-weight: 500; color: var(--themeC-alt); 
            margin-inline-start: 10px; /* مسافة إضافية بين الروابط */
        }

        .theme-controls { display: flex; border-radius: 9px; border: 1px solid var(--sideBd-color); background-color: var(--alikernelC); }
        .theme-btn { padding: 8px 10px; cursor: pointer; color: var(--alikernelBg); display: flex; align-items: center; justify-content: center; border: none; background: none; }
        .theme-btn:not(:first-child) { border-right: 1px solid var(--sideBd-color); }
        .theme-btn svg { width: 16px; height: 16px; opacity: 0.6; transition: 0.2s; }
        .theme-btn.active svg, .theme-btn:hover svg { opacity: 1; }

        /* الأيقونات في الفيديو تظهر باهتة، هذا الإصلاح سيجعلها حادة */
        svg { shape-rendering: geometricPrecision; }

        .ak-breadcrumb-container { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
        .ak-link { font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 6px; }
    </style>
</head>
<body id="nB" class="nB page">
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.body.setAttribute('data-theme', theme);
        })();
    </script>

    <div class="page-wrapper">
        <header class="site-header">
            <div class="header-content">
                <a href="https://www.alikernel.com" class="header-logo-link">
                    <svg class="header-logo-icon" viewBox="0 0 4667.08 4667.08">
                        <rect class="ak-logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                        <path class="ak-logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                        <path class="ak-logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                    </svg>
                    <span>علي كيرنل</span>
                </a>
            </div>
        </header>

        <main class="page-content">
            <div class="static-page-content">
                <div class="ak-breadcrumb-container">
                    <a href="https://www.alikernel.com">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </a>
                    <span style="opacity:0.5">/</span>
                    <div class="ak-link">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        <span>{title}</span>
                    </div>
                </div>
                <slot />
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-logo-section">
                    <a href="https://www.alikernel.com" class="footer-logo-link">
                        <svg class="footer-logo-icon" viewBox="0 0 4667.08 4667.08">
                            <rect class="ak-logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                            <path class="ak-logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                        </svg>
                        <span>علي كيرنل</span>
                    </a>
                    <a href="/privacy">الخصوصية</a>
                    <a href="/terms">الشروط</a>
                </div>
                <div class="theme-controls">
                    <button class="theme-btn" id="theme-btn-dark" onclick="setTheme('dark')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    </button>
                    <button class="theme-btn" id="theme-btn-light" onclick="setTheme('light')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                    </button>
                </div>
            </div>
        </footer>
    </div>

    <script is:inline>
        function setTheme(theme) {
            document.body.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            document.querySelectorAll('.theme-btn').forEach(btn => btn.classList.remove('active'));
            if(theme === 'dark') document.getElementById('theme-btn-dark').classList.add('active');
            else document.getElementById('theme-btn-light').classList.add('active');
        }
        setTheme(localStorage.getItem('theme') || 'dark');
    </script>
</body>
</html>
