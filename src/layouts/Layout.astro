---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - علي كيرنل</title>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon-96x96.png?raw=true' rel='icon' sizes='96x96' type='image/png'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.svg?raw=true' rel='icon' type='image/svg+xml'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.ico?raw=true' rel='shortcut icon'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/apple-touch-icon.png?raw=true' rel='apple-touch-icon' sizes='180x180'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/site.webmanifest?raw=true' rel='manifest'/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" rel="stylesheet">
    <style is:global>
        /* --- تعريفات خط تجوال لضمان تطابق الأوزان --- */
        @font-face {
          font-family: 'Tajawal';
          font-style: normal;
          font-weight: 200;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/tajawal/v9/I7akWp8kj9at9GS726ebxA.woff2) format('woff2');
        }
        @font-face {
          font-family: 'Tajawal';
          font-style: normal;
          font-weight: 300;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/tajawal/v9/I7amWp8kj9at9GS7e6ef3-pS.woff2) format('woff2');
        }
        @font-face {
          font-family: 'Tajawal';
          font-style: normal;
          font-weight: 400;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/tajawal/v9/I7amWp8kj9at9GS7e6ev3-pS.woff2) format('woff2');
        }
        @font-face {
          font-family: 'Tajawal';
          font-style: normal;
          font-weight: 500;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/tajawal/v9/I7amWp8kj9at9GS7e6ef3-pS.woff2) format('woff2');
        }
        @font-face {
          font-family: 'Tajawal';
          font-style: normal;
          font-weight: 700;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/tajawal/v9/I7amWp8kj9at9GS7e6eX3upS.woff2) format('woff2');
        }
        @font-face {
          font-family: 'Tajawal';
          font-style: normal;
          font-weight: 800;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/tajawal/v9/I7amWp8kj9at9GS7e6eW3upS.woff2) format('woff2');
        }
        @font-face {
          font-family: 'Tajawal';
          font-style: normal;
          font-weight: 900;
          font-display: swap;
          src: url(https://fonts.gstatic.com/s/tajawal/v9/I7amWp8kj9at9GS7e6eN3upS.woff2) format('woff2');
        }

        :root { 
            --fontBody: 'Tajawal', 'Noto Sans', sans-serif; 
            --fontBody-alt: 'Tajawal', 'Noto Sans', sans-serif; 
            --fontHead: 'Tajawal', 'Noto Sans', sans-serif; 
            --sideBd-line: 1px; 
            --content-maxWidth: 1024px; 
            --contentPadding: 22px; 
            --head-fontWg: 500; 
        }

        /* --- إعدادات السكرول بار (نفس موقعك الأصلي) --- */
        @media screen and (min-width: 768px) {
            ::-webkit-scrollbar {
                -webkit-appearance: none;
                width: 5px;
                height: 5px;
            }
            ::-webkit-scrollbar-thumb {
                background-color: var(--sideBd-color);
                border-radius: 0px;
            }
            ::-webkit-scrollbar-track {
                background-color: transparent;
            }
        }

        /* --- إعدادات تحديد النصوص --- */
        ::selection {
            color: var(--selectC, #ffffff);
            background-color: var(--selectBg, #3b82f6);
            opacity: .85;
        }

        /* === الوضع المظلم (افتراضي) === */
        body {
            --themeBg: #100f10;
            --postBg: #1b1b1b;
            --headerBg: #1b1b1b;
            --contentBg-sec: #252526;
            --themeLink: #94f27f;
            --themeC: #d9e2f0;
            --themeC-alt: #a0a0a0;
            --sideBd-color: #3a3c3d;
            --alikernelBg: #ffffff;
            --alikernelC: #171717;
            --darkBg: #171717;
            --logoFg: #000000;
            /* تعريف متغيرات التحديد للثيم المظلم */
            --selectC: #000000;
            --selectBg: #94f27f;
            /* ألوان الـ header للصفحات الثابتة */
            --headerBd-color: #3a3c3d;
        }

        /* === الوضع النهاري === */
        body[data-theme="light"] {
            --themeBg: #f6f8fa;
            --postBg: #ffffff;
            --headerBg: #ffffff;
            --contentBg-sec: #f5f3f2;
            --themeLink: #1976d2;
            --themeC: #0e2045;
            --themeC-alt: #666666;
            --sideBd-color: #d2d3d7;
            --alikernelBg: #171717;
            --alikernelC: #ffffff;
            --darkBg: #171717;
            --logoFg: #ffffff;
            /* تعريف متغيرات التحديد للثيم الفاتح */
            --selectC: #ffffff;
            --selectBg: #1976d2;
            /* ألوان الـ header للصفحات الثابتة */
            --headerBd-color: #d2d3d7;
        }

        @media (prefers-color-scheme: dark) {
            body[data-theme="default"] {
                --themeBg: #100f10;
                --postBg: #1b1b1b;
                --headerBg: #1b1b1b;
                --contentBg-sec: #252526;
                --themeLink: #94f27f;
                --themeC: #d9e2f0;
                --themeC-alt: #a0a0a0;
                --sideBd-color: #3a3c3d;
                --alikernelBg: #ffffff;
                --alikernelC: #171717;
                --darkBg: #171717;
                --logoFg: #000000;
                --selectC: #000000;
                --selectBg: #94f27f;
                --headerBd-color: #3a3c3d;
            }
        }

        @media (prefers-color-scheme: light) {
            body[data-theme="default"] {
                --themeBg: #f6f8fa;
                --postBg: #ffffff;
                --headerBg: #ffffff;
                --contentBg-sec: #f5f3f2;
                --themeLink: #1976d2;
                --themeC: #0e2045;
                --themeC-alt: #666666;
                --sideBd-color: #d2d3d7;
                --alikernelBg: #171717;
                --alikernelC: #ffffff;
                --darkBg: #171717;
                --logoFg: #ffffff;
                --selectC: #ffffff;
                --selectBg: #1976d2;
                --headerBd-color: #d2d3d7;
            }
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body { font-family: var(--fontBody); background-color: var(--themeBg); color: var(--themeC); min-height: 100vh; line-height: 1.6; font-weight: 400; }
        a { text-decoration: none; color: inherit; }
        button { font-family: inherit; cursor: pointer; border: none; background: none; }

        /* ===== Page Wrapper ===== */
        .page-wrapper { min-height: 100vh; display: flex; flex-direction: column; }

        /* ===== Site Header - نفس تنسيق بلوجر للصفحات الثابتة ===== */
        .site-header { 
            position: sticky; 
            top: 0; 
            z-index: 100; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            height: 65px; 
            border-bottom: var(--sideBd-line) solid var(--sideBd-color); 
            background-color: rgba(255,255,255,0.4); 
            -webkit-backdrop-filter: blur(8px); 
            backdrop-filter: blur(8px); 
        }
        
        /* الوضع المظلم والتلقائي */
        body[data-theme="dark"] .site-header,
        body[data-theme="default"] .site-header {
            background-color: oklch(0.25 0 0 / 0.4);
        }

        .header-content { 
            width: 100%; 
            max-width: var(--content-maxWidth); 
            margin-inline: auto; 
            padding-inline: var(--contentPadding); 
            display: flex; 
            align-items: center; 
            justify-content: flex-start; 
            gap: 12px; 
        }

        /* ===== Header Logo Link - نفس تنسيق بلوجر headt ===== */
        .header-logo-link { 
            display: flex; 
            align-items: center; 
            font-weight: 700; 
            font-size: 18px; 
            color: var(--themeC); 
        }

        /* الشعار - الوضع المظلم/التلقائي: خلفية بيضاء + حروف سوداء */
        .header-logo-icon { width: 32px; height: 32px; flex-shrink: 0; margin-inline-end: 12px; }
        
        /* تنسيقات الشعار للوضع المظلم والتلقائي */
        body[data-theme="dark"] .header-logo-icon .logo-bg,
        body[data-theme="default"] .header-logo-icon .logo-bg {
            fill: #ffffff;
        }
        body[data-theme="dark"] .header-logo-icon .logo-fg,
        body[data-theme="default"] .header-logo-icon .logo-fg {
            fill: #000000;
        }
        
        /* تنسيقات الشعار للوضع النهاري */
        body[data-theme="light"] .header-logo-icon .logo-bg {
            fill: #171717;
        }
        body[data-theme="light"] .header-logo-icon .logo-fg {
            fill: #ffffff;
        }

        /* ===== Page Content ===== */
        .page-content { flex: 1; }
        .static-page-content { width: 100%; max-width: var(--content-maxWidth); margin-inline: auto; padding: var(--contentPadding); }
        .static-page-content h1 { font-size: 26px; font-weight: 500; margin-bottom: 10px; padding-bottom: 15px; color: var(--themeC); }
        .static-page-content h2 { font-size: 17px; font-weight: 700; margin-top: 32px; margin-bottom: 10px; color: var(--themeC); }
        .static-page-content p { font-size: 15px; color: var(--themeC-alt); margin-bottom: 12px; text-align: justify; font-weight: 400; }
        .static-page-content ul { padding-right: 20px; margin-bottom: 12px; }
        .static-page-content ul li { font-size: 15px; color: var(--themeC-alt); margin-bottom: 8px; text-align: justify; font-weight: 400; }
        .static-page-content strong { color: var(--themeC); font-weight: 700; }

        /* ===== Site Footer ===== */
        .site-footer { 
            border-top: var(--sideBd-line) solid var(--sideBd-color); 
            padding-block: 25px; 
            background-color: var(--headerBg); 
            margin-top: auto; 
        }
        .footer-content { 
            max-width: var(--content-maxWidth); 
            margin-inline: auto; 
            padding-inline: var(--contentPadding); 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
        }
        .footer-static-logo { 
            display: flex; 
            justify-content: center; 
            gap: 8px; 
        }
        .footer-logo-link { 
            display: inline-flex; 
            align-items: center; 
            gap: 6px; 
            color: inherit; 
            text-decoration: none; 
            font-weight: 700; 
            font-size: 14px; 
        }
        .footer-logo-icon { width: 28px; height: 28px; }
        .footer-static-logo a:not(.footer-logo-link) { 
            font-size: 11px; 
            font-weight: 600; 
            opacity: 0.85; 
            display: inline-flex; 
            align-items: center; 
        }
        .footer-static-logo a:not(.footer-logo-link):hover { text-decoration-line: underline !important; }

        /* الشعار - الوضع المظلم / التلقائي: خلفية خضراء + حروف سوداء */
        .footer-logo-icon .logo-bg { fill: var(--alikernelBg); }
        .footer-logo-icon .logo-fg { fill: #000000; }
        /* الشعار - الوضع النهاري: خلفية زرقاء + حروف بيضاء */
        body[data-theme="light"] .footer-logo-icon .logo-bg { fill: var(--alikernelBg); }
        body[data-theme="light"] .footer-logo-icon .logo-fg { fill: #ffffff; }

        /* ===== Theme Controls - نفس تنسيق بلوجر page-controls ===== */
        .page-controls { 
            display: flex; 
            border-radius: 9px; 
            border: 1px solid var(--sideBd-color); 
            background-color: var(--alikernelC); 
        }
        .page-control-btn { 
            position: relative; 
            padding: 8px 9px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            cursor: pointer; 
            color: var(--themeC-alt);
        }
        .page-control-btn:first-child { border-start-start-radius: 8px; border-end-start-radius: 8px; }
        .page-control-btn:last-child { border-start-end-radius: 8px; border-end-end-radius: 8px; }
        .page-control-btn:not(:first-child) { border-right: 1px solid var(--sideBd-color); }
        .page-control-btn svg { width: 15px; height: 15px; fill: none; }
        .page-control-btn.active { background-color: var(--contentBg-sec); }
        .page-control-btn:not(.active) svg { opacity: 0.8; }
        .page-control-btn.active svg, .page-control-btn:hover svg { opacity: 1; }

        /* ألوان الأيقونات حسب الثيم */
        body[data-theme="dark"] #theme-btn-dark svg,
        body[data-theme="dark"] .page-control-btn:hover svg { color: #fff; opacity: 1; }
        body[data-theme="light"] #theme-btn-light svg,
        body[data-theme="light"] .page-control-btn:hover svg { color: #1a1a1a; opacity: 1; }
        body[data-theme="default"] #theme-btn-default svg,
        body[data-theme="default"] .page-control-btn:hover svg { color: var(--alikernelBg); opacity: 1; }

        /* ===== Tooltips ===== */
        @keyframes slideUp { 
            0% { opacity: 0; transform: translateX(-50%) translateY(10px); } 
            100% { opacity: 1; transform: translateX(-50%) translateY(0); } 
        }
        .page-control-btn .tooltip-box { 
            position: absolute; 
            bottom: 100%; 
            left: 50%; 
            transform: translateX(-50%); 
            margin-bottom: 10px; 
            background-color: var(--alikernelBg); 
            color: var(--alikernelC); 
            padding: 6px 12px; 
            border-radius: 6px; 
            font-size: 12px; 
            font-weight: 600; 
            white-space: nowrap; 
            opacity: 0; 
            visibility: hidden; 
            pointer-events: none; 
            z-index: 20; 
        }
        .page-control-btn .tooltip-arrow { 
            position: absolute; 
            bottom: 0; 
            left: 50%; 
            transform: translateX(-50%) translateY(30%) rotate(45deg); 
            width: 10px; 
            height: 10px; 
            background-color: var(--alikernelBg); 
            border-radius: 2px; 
        }
        .page-control-btn:hover .tooltip-box { visibility: visible; animation: slideUp 0.2s ease-out forwards; }

        /* ===== View Transitions ===== */
        ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
        ::view-transition-new(root) { z-index: 2; }
        ::view-transition-group(root) { animation-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1); }

        /* ===== Responsive ===== */
        @media (max-width: 768px) { .footer-content { gap: 15px; flex-wrap: wrap; justify-content: center; } }

        /* ===== Breadcrumb & Icons ===== */
        .ak-breadcrumb-container { display: flex; align-items: center; direction: rtl; gap: 12px; margin-bottom: 8px; }
        .ak-breadcrumb-item { display: flex; align-items: center; gap: 12px; }
        .ak-link { 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            text-decoration: none; 
            color: inherit; 
            font-size: 14px; 
            font-weight: 700; 
        }
        .ak-home-link svg { 
            width: 18px; 
            height: 18px; 
            opacity: 0.5; 
            transition: color 0.2s ease; 
        }
        .ak-home-link:hover svg { opacity: 1; color: var(--alikernelBg); }
        .ak-breadcrumb-container svg { fill: none; stroke: currentColor; stroke-width: 1.5; flex-shrink: 0; }
        .ak-sep svg { width: 12px; height: 12px; opacity: 0.7; }
        .ak-icon-book { width: 18px; height: 18px; }

    </style>
</head>
<body id="nB" class="nB page">
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.body.setAttribute('data-theme', theme);
            if (theme === 'dark') document.documentElement.classList.add('dark');
            if (theme === 'light') document.documentElement.classList.add('light');
            if (theme === 'default') document.documentElement.classList.add('default');
        })();
        window.addEventListener('storage', function(e) {
            if (e.key === 'theme' && e.newValue) {
                document.body.setAttribute('data-theme', e.newValue);
            }
        });
    </script>

    <div class="page-wrapper">
        <header class="site-header">
            <div class="header-content">
                <a href="https://www.alikernel.com" class="header-logo-link">
                    <svg class="header-logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4667.08 4667.08">
                        <rect class="logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                        <path class="logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                        <path class="logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                    </svg>
                    <span>علي كيرنل</span>
                </a>
            </div>
        </header>

        <main class="page-content">
            <div class="static-page-content">
                <div class="ak-breadcrumb-container">
                    <a class="ak-home-link" href="https://www.alikernel.com" title="الرئيسية">
                        <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
                            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
                            <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        </svg>
                    </a>
                    <div class="ak-breadcrumb-item">
                        <span class="ak-sep">
                            <svg viewBox="0 0 24 24"><path d="M15 19.9201L8.47997 13.4001C7.70997 12.6301 7.70997 11.3701 8.47997 10.6001L15 4.08008"/></svg>
                        </span>
                        <div class="ak-link current">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-text size-4 shrink-0 ak-icon-book" aria-hidden="true"><path d="M12 7v14"></path><path d="M16 12h2"></path><path d="M16 8h2"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path><path d="M6 12h2"></path><path d="M6 8h2"></path></svg>
                            <span>{title}</span>
                        </div>
                    </div>
                </div>
                <slot />
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-static-logo">
                    <a href="https://www.alikernel.com" class="footer-logo-link">
                        <svg class="footer-logo-icon" viewBox="0 0 4667.08 4667.08" xmlns="http://www.w3.org/2000/svg">
                            <rect class="logo-bg" height="4667.08" rx="1004" ry="1004" width="4667.08"/>
                            <path class="logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                            <path class="logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                        </svg>
                        <span class="footer-logo-name">علي كيرنل</span>
                    </a>
                    <a href="/privacy">الخصوصيه</a>
                    <a href="/terms">الشروط</a>
                </div>
                <div class="page-controls">
                    <div class="page-control-btn" id="theme-btn-dark" onclick="setTheme('dark', event)" role="button">
                        <svg aria-hidden="true" class="lucide lucide-moon-star opacity-60" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 5h4"/><path d="M20 3v4"/><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
                        </svg>
                        <div class="tooltip-box">مظلم<span class="tooltip-arrow"></span></div>
                    </div>
                    <div class="page-control-btn" id="theme-btn-light" onclick="setTheme('light', event)" role="button">
                        <svg aria-hidden="true" class="lucide lucide-sun opacity-60" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
                        </svg>
                        <div class="tooltip-box">نهار<span class="tooltip-arrow"></span></div>
                    </div>
                    <div class="page-control-btn" id="theme-btn-default" onclick="setTheme('default', event)" role="button">
                        <svg aria-hidden="true" class="lucide lucide-monitor opacity-60" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
                            <rect height="14" rx="2" width="20" x="2" y="3"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>
                        </svg>
                        <div class="tooltip-box">تلقائي<span class="tooltip-arrow"></span></div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script is:inline>
        (function(){
            const ANIMATION_DURATION=800;
            const ANIMATION_EASING="ease-out";
            let clickX=window.innerWidth/2;
            let clickY=window.innerHeight/2;
            
            async function doTransition(callback){
                if(!document.startViewTransition){callback();return}
                try{
                    const radius=Math.hypot(Math.max(clickX,window.innerWidth-clickX),Math.max(clickY,window.innerHeight-clickY));
                    const transition=document.startViewTransition(callback);
                    await transition.ready;
                    document.documentElement.animate(
                        {clipPath:["circle(0px at "+clickX+"px "+clickY+"px)","circle("+radius+"px at "+clickX+"px "+clickY+"px)"]},
                        {duration:ANIMATION_DURATION,easing:ANIMATION_EASING,pseudoElement:"::view-transition-new(root)"}
                    )
                }catch(e){callback()}
            }
            
            function applyTheme(theme){
                const html=document.documentElement;
                const body=document.body;
                html.classList.remove("light","dark","default");
                body.classList.remove("light","dark","default");
                html.classList.add(theme);
                body.classList.add(theme);
                html.setAttribute("data-theme",theme);
                body.setAttribute("data-theme",theme);
                localStorage.setItem("theme",theme);
            }
            
            function updateActiveButton(){
                const currentTheme=document.body.getAttribute("data-theme")||"default";
                document.querySelectorAll(".page-control-btn").forEach(function(btn){
                    btn.classList.remove("active")
                });
                const activeBtn=document.getElementById("theme-btn-"+currentTheme);
                if(activeBtn){activeBtn.classList.add("active")}
            }
            
            window.setTheme=function(theme,eventOrType){
                if(eventOrType&&eventOrType.currentTarget){
                    const rect=eventOrType.currentTarget.getBoundingClientRect();
                    clickX=rect.left+rect.width/2;
                    clickY=rect.top+rect.height/2
                }else if(eventOrType&&eventOrType.clientX!==undefined){
                    clickX=eventOrType.clientX;
                    clickY=eventOrType.clientY
                }
                doTransition(function(){
                    applyTheme(theme);
                    setTimeout(updateActiveButton,50)
                })
            };
            
            if(document.readyState==="loading"){
                document.addEventListener("DOMContentLoaded",function(){
                    setTimeout(function(){updateActiveButton()},500)
                })
            }else{
                setTimeout(function(){updateActiveButton()},500)
            }
        })();
    </script>
</body>
</html>
