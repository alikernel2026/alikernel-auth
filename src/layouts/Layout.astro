---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - علي كيرنل</title>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon-96x96.png?raw=true' rel='icon' sizes='96x96' type='image/png'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.svg?raw=true' rel='icon' type='image/svg+xml'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.ico?raw=true' rel='shortcut icon'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/apple-touch-icon.png?raw=true' rel='apple-touch-icon' sizes='180x180'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/site.webmanifest?raw=true' rel='manifest'/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <style is:global>
        :root { --fontBody: 'Noto Sans', 'Tajawal', sans-serif; --sideBd-line: 1px; --content-maxWidth: 1024px; --contentPadding: 22px; }

        /* === الوضع المظلم (افتراضي) === */
        body {
            --themeBg: #100f10;
            --postBg: #1b1b1b;
            --headerBg: #1b1b1b;
            --contentBg-sec: #252526;
            --themeLink: #94f27f;
            --themeC: #d9e2f0;
            --themeC-alt: #a0a0a0;
            --sideBd-color: #3a3c3d;
            --alikernelBg: #ffffff;
            --alikernelC: #171717;
            --darkBg: #171717;
            /* الشعار: خلفية خضراء + حروف سوداء */
            --logoFg: #000000;
        }

        /* === الوضع النهاري === */
        body[data-theme="light"] {
            --themeBg: #f6f8fa;
            --postBg: #ffffff;
            --headerBg: #ffffff;
            --contentBg-sec: #f5f3f2;
            --themeLink: #1976d2;
            --themeC: #0e2045;
            --themeC-alt: #666666;
            --sideBd-color: #d2d3d7;
            --alikernelBg: #171717;
            --alikernelC: #ffffff;
            --darkBg: #171717;
            /* الشعار: خلفية زرقاء + حروف بيضاء */
            --logoFg: #ffffff;
        }

        @media (prefers-color-scheme: dark) {
            body[data-theme="default"] {
                --themeBg: #100f10;
                --postBg: #1b1b1b;
                --headerBg: #1b1b1b;
                --contentBg-sec: #252526;
                --themeLink: #94f27f;
                --themeC: #d9e2f0;
                --themeC-alt: #a0a0a0;
                --sideBd-color: #3a3c3d;
                --alikernelBg: #ffffff;
                --alikernelC: #171717;
                --darkBg: #171717;
                /* الشعار: خلفية خضراء + حروف سوداء */
                --logoFg: #000000;
            }
        }

        @media (prefers-color-scheme: light) {
            body[data-theme="default"] {
                --themeBg: #f6f8fa;
                --postBg: #ffffff;
                --headerBg: #ffffff;
                --contentBg-sec: #f5f3f2;
                --themeLink: #1976d2;
                --themeC: #0e2045;
                --themeC-alt: #666666;
                --sideBd-color: #d2d3d7;
                --alikernelBg: #171717;
                --alikernelC: #ffffff;
                --darkBg: #171717;
                /* الشعار: خلفية زرقاء + حروف بيضاء */
                --logoFg: #ffffff;
            }
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body { font-family: var(--fontBody); background-color: var(--themeBg); color: var(--themeC); min-height: 100vh; line-height: 1.6; }
        a { text-decoration: none; color: inherit; }
        button { font-family: inherit; cursor: pointer; border: none; background: none; }
        .page-wrapper { min-height: 100vh; display: flex; flex-direction: column; }
        .site-header { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; justify-content: center; height: 65px; border-bottom: 1px solid var(--sideBd-color); background-color: oklch(0.25 0 0 / 0.4); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
        body[data-theme="light"] .site-header { background-color: rgba(255,255,255,0.4); }
        @media (prefers-color-scheme: light) { body[data-theme="default"] .site-header { background-color: rgba(255,255,255,0.4); } }
        .header-content { width: 100%; max-width: var(--content-maxWidth); margin-inline: auto; padding-inline: var(--contentPadding); display: flex; align-items: center; justify-content: flex-start; gap: 12px; font-weight: 500; font-size: 18px; }
        .header-logo-link { display: flex; align-items: center; gap: 12px; color: var(--themeC); font-weight: 700; font-size: 18px; }
        .header-logo-icon { width: 32px; height: 32px; }
        .page-content { flex: 1; }
        .static-page-content { width: 100%; max-width: var(--content-maxWidth); margin-inline: auto; padding: var(--contentPadding); }
        .static-page-content h1 { font-size: 26px; font-weight: 500; margin-bottom: 10px; padding-bottom: 15px; color: var(--themeC); }
        .static-page-content h2 { font-size: 17px; font-weight: 700; margin-top: 32px; margin-bottom: 10px; color: var(--themeC); }
        .static-page-content p { font-size: 15px; color: var(--themeC-alt); margin-bottom: 12px; text-align: justify; }
        .static-page-content ul { padding-right: 20px; margin-bottom: 12px; }
        .static-page-content ul li { font-size: 15px; color: var(--themeC-alt); margin-bottom: 8px; text-align: justify; }
        .static-page-content strong { color: var(--themeC); }
        .about-author { padding: 60px 0 20px 0; }
        .about-cont { position: relative; display: flex; flex-direction: column; max-width: 820px; margin: auto; padding: 80px 30px 90px 30px; background-color: var(--postBg); border: var(--sideBd-line) solid var(--sideBd-color); border-radius: 12px; gap: 12px; }
        .about-cont img { position: absolute; top: -55px; left: 50%; transform: translateX(-50%); width: 110px; height: 110px; border-radius: 50%; border: 6px solid var(--postBg); box-shadow: 0 5px 20px rgba(0,0,0,0.2); object-fit: cover; }
        .about-cont p { font-size: 15px; color: var(--themeC-alt); text-align: justify; }
        .about-btn { text-align: center; position: absolute; bottom: 25px; left: 0; right: 0; }
        .profile-btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 20px; border-radius: 8px; background-color: var(--alikernelBg); color: var(--alikernelC); font-size: 14px; font-weight: 600; border: 1px solid var(--sideBd-color); transition: opacity 0.2s; }
        .profile-btn:hover { opacity: 0.85; }
        .stats-website { display: flex; gap: 15px; flex-wrap: wrap; margin: 20px 0 40px 0; }
        .stats-cont { flex: 1; min-width: 200px; background-color: var(--postBg); border: var(--sideBd-line) solid var(--sideBd-color); border-radius: 10px; padding: 20px; display: flex; justify-content: center; }
        .stats-inner { display: flex; flex-direction: column; align-items: center; gap: 8px; }
        .stats-name { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--themeC-alt); }
        .stats-name svg { width: 18px; height: 18px; }
        .stats-number { font-size: 28px; font-weight: 600; color: var(--themeLink); }
        .site-footer { border-top: 1px solid var(--sideBd-color); padding-block: 25px; background-color: var(--headerBg); margin-top: auto; }
        .footer-content { max-width: var(--content-maxWidth); margin-inline: auto; padding-inline: var(--contentPadding); display: flex; justify-content: space-between; align-items: center; }
        .footer-logo-section { display: flex; align-items: center; gap: 8px; }
        .footer-logo-link { display: flex; align-items: center; gap: 6px; color: var(--themeC); font-weight: 500; font-size: 14px; }
        .footer-logo-icon { width: 28px; height: 28px; }
        .footer-logo-section a:not(.footer-logo-link) { font-size: 12px; opacity: .85; }
        .footer-logo-section a:not(.footer-logo-link):hover { text-decoration: underline; }
        .theme-controls { display: flex; border: 1px solid var(--sideBd-color); border-radius: 9px; overflow: visible; background-color: var(--alikernelC); }
        .theme-btn { position: relative; padding: 8px 9px; display: flex; align-items: center; justify-content: center; background-color: transparent; color: var(--themeC-alt); cursor: pointer; transition: all 0.2s; }
        .theme-btn:first-child { border-radius: 0 8px 8px 0; }
        .theme-btn:last-child { border-radius: 8px 0 0 8px; }
        .theme-btn:not(:last-child) { border-left: 1px solid var(--sideBd-color); }
        .theme-btn:hover { color: var(--alikernelBg); }
        .theme-btn.active { background-color: var(--contentBg-sec); }
        .theme-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; }
        @keyframes slideUp { 0% { opacity: 0; transform: translateX(-50%) translateY(10px); } 100% { opacity: 1; transform: translateX(-50%) translateY(0); } }
        .theme-btn .tooltip-box { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 10px; background-color: var(--alikernelBg); color: var(--alikernelC); padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; white-space: nowrap; opacity: 0; visibility: hidden; pointer-events: none; z-index: 20; }
        .theme-btn .tooltip-arrow { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%) translateY(30%) rotate(45deg); width: 10px; height: 10px; background-color: var(--alikernelBg); border-radius: 2px; }
        .theme-btn:hover .tooltip-box { visibility: visible; animation: slideUp 0.2s ease-out forwards; }
        ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
        ::view-transition-new(root) { z-index: 2; }
        @media (max-width: 768px) { .footer-content { gap: 15px; } }

        /* --- Breadcrumb & Home Icon --- */
        .ak-breadcrumb-container { display: flex; align-items: center; direction: rtl; gap: 12px; margin-bottom: 8px; }
        .ak-breadcrumb-item { display: flex; align-items: center; gap: 12px; }
        .ak-link { display: flex; align-items: center; gap: 8px; text-decoration: none; color: inherit; font-size: 14px; font-weight: 500; }
        .ak-home-link svg { color: var(--themeC-alt); transition: color 0.2s ease; }
        .ak-home-link:hover svg { color: var(--alikernelBg); }
        .ak-breadcrumb-container svg { fill: none; stroke: currentColor; stroke-width: 1.5; flex-shrink: 0; width: 16px; height: 16px; }
        .ak-sep svg { width: 12px; height: 12px; opacity: .7; color: var(--themeC-alt); }

        /* --- الشعار ---
             خلفية: var(--themeLink)  → أخضر في المظلم / أزرق في النهار
             حروف:  var(--logoFg)     → أسود في المظلم / أبيض في النهار
        ------------------------------------------------- */
        .ak-logo-bg { fill: var(--themeLink); }
        .ak-logo-fg { fill: var(--logoFg); }
    </style>
</head>
<body id="nB" class="nB">
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.body.setAttribute('data-theme', theme);
        })();
        window.addEventListener('storage', function(e) {
            if (e.key === 'theme' && e.newValue) {
                document.body.setAttribute('data-theme', e.newValue);
            }
        });
    </script>

    <div class="page-wrapper">
        <header class="site-header">
            <div class="header-content">
                <a href="https://www.alikernel.com" class="header-logo-link">
                    <!-- ===== شعار الهيدر ===== -->
                    <svg class="header-logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4667.08 4667.08">
                        <rect class="ak-logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                        <path class="ak-logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                        <path class="ak-logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                    </svg>
                    علي كيرنل
                </a>
            </div>
        </header>

        <main class="page-content">
            <div class="static-page-content">
                <div class="ak-breadcrumb-container">
                    <a class="ak-home-link" href="https://www.alikernel.com" title="الرئيسية">
                        <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
                            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
                            <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        </svg>
                    </a>
                    <div class="ak-breadcrumb-item">
                        <span class="ak-sep">
                            <svg viewBox="0 0 24 24"><path d="M15 19.9201L8.47997 13.4001C7.70997 12.6301 7.70997 11.3701 8.47997 10.6001L15 4.08008"/></svg>
                        </span>
                        <div class="ak-link current">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-text size-4 shrink-0" aria-hidden="true"><path d="M12 7v14"></path><path d="M16 12h2"></path><path d="M16 8h2"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path><path d="M6 12h2"></path><path d="M6 8h2"></path></svg>
                            <span>{title}</span>
                        </div>
                    </div>
                </div>
                <slot />
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-logo-section">
                    <a href="https://www.alikernel.com" class="footer-logo-link">
                        <!-- ===== شعار الفوتر ===== -->
                        <svg class="footer-logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4667.08 4667.08">
                            <rect class="ak-logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                            <path class="ak-logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                            <path class="ak-logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                        </svg>
                        <span>علي كيرنل</span>
                    </a>
                    <a href="/privacy">الخصوصية</a>
                    <a href="/terms">الشروط</a>
                </div>
                <div class="theme-controls">
                    <button class="theme-btn" id="theme-btn-dark" onclick="setTheme('dark', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M19 3v4"/><path d="M21 5h-4"/></svg>
                        <div class="tooltip-box">مظلم<div class="tooltip-arrow"></div></div>
                    </button>
                    <button class="theme-btn" id="theme-btn-light" onclick="setTheme('light', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                        <div class="tooltip-box">نهار<div class="tooltip-arrow"></div></div>
                    </button>
                    <button class="theme-btn" id="theme-btn-system" onclick="setTheme('default', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        <div class="tooltip-box">تلقائي<div class="tooltip-arrow"></div></div>
                    </button>
                </div>
            </div>
        </footer>
    </div>

    <script is:inline>
    function setTheme(theme, animate) {
        function applyTheme() {
            document.body.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            document.querySelectorAll('.theme-btn').forEach(function(btn) { btn.classList.remove('active'); });
            if (theme === 'dark') document.getElementById('theme-btn-dark').classList.add('active');
            else if (theme === 'light') document.getElementById('theme-btn-light').classList.add('active');
            else document.getElementById('theme-btn-system').classList.add('active');
        }
        if (!animate || !document.startViewTransition) { applyTheme(); return; }
        try {
            var btn = document.activeElement;
            var x = window.innerWidth/2, y = window.innerHeight/2;
            if (btn && btn.classList && btn.classList.contains('theme-btn')) {
                var r = btn.getBoundingClientRect(); x = r.left + r.width/2; y = r.top + r.height/2;
            }
            var radius = Math.hypot(Math.max(x, window.innerWidth-x), Math.max(y, window.innerHeight-y));
            var transition = document.startViewTransition(applyTheme);
            transition.ready.then(function() {
                document.documentElement.animate(
                    { clipPath: ['circle(0px at '+x+'px '+y+'px)', 'circle('+radius+'px at '+x+'px '+y+'px)'] },
                    { duration: 800, easing: 'ease-out', pseudoElement: '::view-transition-new(root)' }
                );
            });
        } catch(e) { applyTheme(); }
    }
    var savedTheme = localStorage.getItem('theme') || 'default';
    setTheme(savedTheme, false);
    </script>
</body>
</html>
