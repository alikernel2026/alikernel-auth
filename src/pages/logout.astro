---
export const prerender = false;
import { createAuth } from '../lib/auth';
const env = (Astro.locals as any).runtime.env;
const auth = createAuth(env);
await auth.api.signOut({ headers: Astro.request.headers });
---
<!DOCTYPE html>
<html>
<head>
<meta http-equiv="refresh" content="0;url=https://www.alikernel.com">
<script>
localStorage.setItem('auth_event', 'signout_' + Date.now());
setTimeout(function() {
  localStorage.clear();
  window.location.href = "https://www.alikernel.com";
}, 300);
</script>
</head>
<body></body>
</html>
