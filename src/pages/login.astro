---
// هذا القسم مخصص لعمليات السيرفر في Astro
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - علي كيرنل</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="fullscreen-modal">
        <a href="https://www.alikernel.com" class="modal-close-btn">
            <svg viewBox="0 0 24 24"><path d="M9.57 5.92993L3.5 11.9999L9.57 18.0699" stroke="currentColor" stroke-width="1.5"></path></svg>
        </a>
        <div class="login-container">
            <div class="login-card">
                <h2>أهلاً بعودتك</h2>
                <button class="social-btn" id="google-login">
                    <span>الدخول باستخدام Google</span>
                </button>
                <button class="social-btn" id="github-login">
                    <span>الدخول باستخدام GitHub</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        import { createAuthClient } from "better-auth/client";
        
        // ربط الموقع بالدومين الخاص بكِ حصراً
        const auth = createAuthClient({
            baseURL: "https://www.alikernel.com"
        });

        // تشغيل زر جوجل
        document.getElementById('google-login')?.addEventListener('click', async () => {
            await auth.signIn.social({
                provider: "google",
                callbackURL: "/account"
            });
        });

        // تشغيل زر جيت هاب
        document.getElementById('github-login')?.addEventListener('click', async () => {
            await auth.signIn.social({
                provider: "github",
                callbackURL: "/account"
            });
        });
    </script>
</body>
</html>
