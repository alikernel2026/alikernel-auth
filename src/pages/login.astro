---
// src/pages/login.astro
layout: null
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول | Alikernel</title>
    <link rel="stylesheet" href="/src/styles/global.css"> 
</head>
<body>
    <div class="fullscreen-modal">
        <div class="login-container">
            <div class="login-header">
                <img src="/logo.svg" class="site-logo-placeholder" alt="Logo">
                <span>Alikernel Auth</span>
            </div>

            <div class="login-card">
                <h2>تسجيل الدخول</h2>
                <p>اختر الطريقة المناسبة للدخول إلى حسابك</p>

                <button id="google-login" class="social-btn google">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="">
                    سجل الدخول بواسطة جوجل
                </button>

                <button id="github-login" class="social-btn github">
                    <img src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png" alt="" style="width:20px;">
                    سجل الدخول بواسطة جيثب
                </button>
            </div>
        </div>
    </div>

    <script>
        // هذا السطر هو الذي سيجعل الأزرار تعمل فعلياً
        import { createAuthClient } from "better-auth/client";
        
        const authClient = createAuthClient({
            baseURL: window.location.origin
        });

        document.getElementById('google-login').onclick = async () => {
            await authClient.signIn.social({ 
                provider: "google", 
                callbackURL: "https://www.alikernel.com" 
            });
        };

        document.getElementById('github-login').onclick = async () => {
            await authClient.signIn.social({ 
                provider: "github", 
                callbackURL: "https://www.alikernel.com" 
            });
        };
    </script>
</body>
</html>
