---
// src/pages/login.astro
layout: null
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تسجيل الدخول | Alikernel</title>
    <link rel="stylesheet" href="/src/styles/global.css"> 
</head>
<body>
    <div class="fullscreen-modal">
        <div class="login-container">
            <div class="login-header">
                <img src="/logo.svg" class="site-logo-placeholder" alt="Logo">
                <span>Alikernel Auth</span>
            </div>

            <div class="login-card">
                <h2>تسجيل الدخول</h2>
                <p>اختر الطريقة المناسبة للدخول إلى حسابك</p>

                <button id="google-login" class="social-btn">
                    سجل الدخول بواسطة جوجل
                </button>

                <button id="github-login" class="social-btn">
                    سجل الدخول بواسطة جيثب
                </button>
            </div>
        </div>
    </div>

    <script>
        // هذا هو الجزء الذي سيجعل الأزرار "تعمل" وتنتقل لصفحة جوجل/جيثب
        import { createAuthClient } from "better-auth/client";
        
        const authClient = createAuthClient({
            baseURL: "https://www.alikernel.com"
        });

        // تشغيل زر جوجل
        const googleBtn = document.getElementById('google-login');
        if (googleBtn) {
            googleBtn.onclick = async () => {
                await authClient.signIn.social({ 
                    provider: "google", 
                    callbackURL: "https://www.alikernel.com" 
                });
            };
        }

        // تشغيل زر جيثب
        const githubBtn = document.getElementById('github-login');
        if (githubBtn) {
            githubBtn.onclick = async () => {
                await authClient.signIn.social({ 
                    provider: "github", 
                    callbackURL: "https://www.alikernel.com" 
                });
            };
        }
    </script>
</body>
</html>
