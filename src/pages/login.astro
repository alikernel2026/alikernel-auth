---
import '../styles/style.css';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - علي كيرنل</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <style>
        /* --- الشعار: يتغير مع الثيم --- */
        .logo-bg { fill: var(--alikernelBg); }
        .logo-fg { fill: #000000; }
        [data-theme="light"] .logo-fg { fill: #ffffff; }
        @media (prefers-color-scheme: light) {
            [data-theme="default"] .logo-fg { fill: #ffffff; }
        }
    </style>
</head>
<body id="nB" class="nB">
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.body.setAttribute('data-theme', theme);
        })();
        window.addEventListener('storage', function(e) {
            if (e.key === 'theme' && e.newValue) {
                document.body.setAttribute('data-theme', e.newValue);
            }
        });
    </script>

    <div class="fullscreen-modal">
        <div class="login-container">
            <a href="https://www.alikernel.com" class="login-header">
                <!-- ===== الشعار الجديد ===== -->
                <svg class="site-logo-placeholder" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4667.08 4667.08">
                    <rect class="logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                    <path class="logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                    <path class="logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                </svg>
                <span>علي كيرنل</span>
            </a>

            <div class="login-card">
                <h2>أهلاً بعودتك</h2>
                <p>سجل دخولك باستخدام حسابك الاجتماعي</p>

                <button class="social-btn" id="google-signin-btn">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"></path></svg>
                    <span>الدخول باستخدام Google</span>
                </button>

                <button class="social-btn" id="github-signin-btn">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
                    <span>الدخول باستخدام GitHub</span>
                </button>
            </div>

            <div class="login-footer">
                <p>بالنقر على "متابعة"، فأنك توافق على <a href="/terms">شروط الخدمة</a> و <a href="/privacy">سياسة الخصوصية</a>.</p>
            </div>
        </div>
    </div>

    <script>
        import { createAuthClient } from "better-auth/client";

        const authClient = createAuthClient({
            baseURL: "https://www.alikernel.com"
        });

        authClient.getSession().then(({ data }) => {
            if (data && data.user) {
                window.location.href = "https://www.alikernel.com";
            }
        });

        const googleBtn = document.getElementById('google-signin-btn');
        if (googleBtn) {
            googleBtn.addEventListener('click', async () => {
                googleBtn.style.opacity = "0.5";
                await authClient.signIn.social({
                    provider: "google",
                    callbackURL: "/account"
                });
            });
        }

        const githubBtn = document.getElementById('github-signin-btn');
        if (githubBtn) {
            githubBtn.addEventListener('click', async () => {
                githubBtn.style.opacity = "0.5";
                await authClient.signIn.social({
                    provider: "github",
                    callbackURL: "/account"
                });
            });
        }
    </script>
</body>
</html>
