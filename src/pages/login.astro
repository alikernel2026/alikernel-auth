// src/pages/login.astro
layout: null
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>علي كمبيوتر سفن | تسجيل الدخول</title>
    <link rel="stylesheet" href="/src/styles/global.css">
    <style>
        /* ستايل احتياطي لضمان ظهور اللون الأسود والبطاقة فوراً */
        body {
            background-color: #000;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            font-family: sans-serif;
        }
        .login-card {
            background-color: #111;
            padding: 40px;
            border-radius: 20px;
            border: 1px solid #333;
            text-align: center;
            width: 350px;
        }
        .social-btn {
            background-color: #222;
            border: 1px solid #333;
            color: #fff;
            padding: 12px;
            border-radius: 10px;
            width: 100%;
            margin-top: 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 16px;
        }
        .social-btn:hover { background-color: #333; }
        .footer-text { font-size: 12px; color: #888; margin-top: 20px; line-height: 1.6; }
        .footer-text a { color: #fff; text-decoration: underline; }
    </style>
</head>
<body>

    <div style="margin-bottom: 20px; font-size: 24px;">علي كمبيوتر سفن</div>

    <div class="login-card">
        <h2 style="margin-bottom: 10px;">مرحبًا بعودتك</h2>
        <p style="color: #aaa; margin-bottom: 30px;">تسجيل الدخول باستخدام حسابك الاجتماعي</p>

        <button id="google-login" class="social-btn">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="20">
            تسجيل الدخول باستخدام Google
        </button>

        <button id="github-login" class="social-btn">
            <svg width="20" viewBox="0 0 24 24" fill="#fff"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            تسجيل الدخول باستخدام GitHub
        </button>
    </div>

    <div class="footer-text">
        بالنقر على "متابعة"، فإنك توافق على <br>
        <a href="#">شروط الخدمة</a> و <a href="#">سياسة الخصوصية</a>.
    </div>

    <script>
        import { createAuthClient } from "better-auth/client";
        const authClient = createAuthClient({ baseURL: window.location.origin });

        document.getElementById('google-login').onclick = async () => {
            await authClient.signIn.social({ provider: "google", callbackURL: "/" });
        };

        document.getElementById('github-login').onclick = async () => {
            await authClient.signIn.social({ provider: "github", callbackURL: "/" });
        };
    </script>
</body>
</html>
