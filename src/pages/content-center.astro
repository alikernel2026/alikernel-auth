---
import '../styles/style.css';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مركز المحتوى - علي كيرنل</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>
<body id="nB" class="nB">
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.body.setAttribute('data-theme', theme);
        })();
        window.addEventListener('storage', function(e) {
            if (e.key === 'theme' && e.newValue) {
                document.body.setAttribute('data-theme', e.newValue);
            }
        });
    </script>

    <div class="page-wrapper">
        <header class="site-header">
            <div class="header-content">
                <a href="https://www.alikernel.com" class="header-logo-link">
                    <svg class="header-logo-icon" viewBox="0 0 124 124" fill="none">
                        <rect width="124" height="124" rx="24" fill="#F97316"/>
                        <path d="M19.375 36.782v63.843a4 4 0 0 0 4 4h63.843c3.564 0 5.348-4.309 2.829-6.828L26.203 33.953c-2.52-2.52-6.828-.735-6.828 2.829" fill="#fff"/>
                        <circle cx="63.211" cy="37.539" r="18.164" fill="#000"/>
                        <rect opacity=".4" x="81.133" y="80.72" width="17.569" height="17.388" rx="4" transform="rotate(-45 81.133 80.72)" fill="#FDBA74"/>
                    </svg>
                    <a href="https://www.alikernel.com">علي كيرنل</a>
                </a>
            </div>
        </header>

        <main class="page-content">
            <div class="static-page-content">
                <h1>مركز المحتوى</h1>
                <div id="sitemap-wrapper">
                    <div id="sitemap-container">
                        <nav id="sitemap-nav">
                            <div class="column-header">الأقسام</div>
                            <ul id="tab-list"></ul>
                        </nav>
                        <div id="sitemap-main">
                            <div class="column-header">اسم المقال</div>
                            <ul id="post-list-titles"></ul>
                        </div>
                        <div id="sitemap-date">
                            <div class="column-header">التاريخ</div>
                            <ul id="post-list-dates"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-logo-section">
                    <a href="https://www.alikernel.com" class="footer-logo-link">
                        <svg class="footer-logo-icon" viewBox="0 0 124 124" fill="none">
                            <rect width="124" height="124" rx="24" fill="#F97316"/>
                            <path d="M19.375 36.782v63.843a4 4 0 0 0 4 4h63.843c3.564 0 5.348-4.309 2.829-6.828L26.203 33.953c-2.52-2.52-6.828-.735-6.828 2.829" fill="#fff"/>
                            <circle cx="63.211" cy="37.539" r="18.164" fill="#000"/>
                            <rect opacity=".4" x="81.133" y="80.72" width="17.569" height="17.388" rx="4" transform="rotate(-45 81.133 80.72)" fill="#FDBA74"/>
                        </svg>
                        <span>علي كيرنل</span>
                    </a>
                    <a href="/privacy">الخصوصية</a>
                    <a href="/terms">الشروط</a>
                </div>
                <div class="theme-controls">
                    <button class="theme-btn" id="theme-btn-dark" onclick="setTheme('dark', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M19 3v4"/><path d="M21 5h-4"/></svg>
                        <div class="tooltip-box">مظلم<div class="tooltip-arrow"></div></div>
                    </button>
                    <button class="theme-btn" id="theme-btn-light" onclick="setTheme('light', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                        <div class="tooltip-box">نهار<div class="tooltip-arrow"></div></div>
                    </button>
                    <button class="theme-btn" id="theme-btn-system" onclick="setTheme('default', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        <div class="tooltip-box">تلقائي<div class="tooltip-arrow"></div></div>
                    </button>
                </div>
            </div>
        </footer>
    </div>

    <style>
        #sitemap-wrapper { direction: rtl; }
        #sitemap-container { display: flex; border: var(--sideBd-line) solid var(--sideBd-color); min-height: 500px; border-radius: 10px; overflow: hidden; }
        .column-header { padding: 15px; background: rgba(255,255,255,0.05); border-bottom: var(--sideBd-line) solid var(--sideBd-color); font-weight: 700; font-size: 14px; color: var(--themeC); }
        #sitemap-nav { width: 200px; border-left: var(--sideBd-line) solid var(--sideBd-color); flex-shrink: 0; }
        #tab-list { list-style: none; padding: 0; margin: 0; }
        #tab-list li { position: relative; padding: 12px 20px 12px 15px; cursor: pointer; transition: 0.2s; border-bottom: var(--sideBd-line) solid var(--sideBd-color); display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: var(--themeC); }
        #tab-list li:hover { background: rgba(255,255,255,0.03); }
        #tab-list li.active { background: color-mix(in srgb, var(--themeLink), transparent 93%); color: var(--themeLink); }
        .count-badge { font-size: 11px; background: var(--contentBg-sec); border-radius: 50px; padding: 2px 7px; min-width: 20px; text-align: center; color: var(--themeC-alt); }
        #tab-list li.active .count-badge { color: var(--themeLink); }
        #sitemap-main { flex-grow: 1; border-left: var(--sideBd-line) solid var(--sideBd-color); }
        #sitemap-date { width: 150px; flex-shrink: 0; }
        ul[id^="post-list"] { list-style: none; padding: 0; margin: 0; }
        .post-item-row { height: 48px; display: flex; align-items: center; padding: 0 15px; border-bottom: var(--sideBd-line) solid var(--sideBd-color); }
        .post-link { color: var(--themeC); font-size: 14px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
        .post-link:hover { color: var(--themeLink); }
        .date-text { font-size: 13px; color: var(--themeC-alt); }
        .new-tag { color: var(--themeLink); font-size: 10px; font-weight: 700; margin-right: 8px; border: 1px solid var(--themeLink); padding: 1px 5px; border-radius: 3px; }
        .loading-tabs { padding: 20px; text-align: center; color: var(--themeC-alt); font-size: 14px; }
        @media (max-width: 768px) {
            #sitemap-container { flex-direction: column; }
            #sitemap-nav { width: 100%; border-left: none; border-bottom: var(--sideBd-line) solid var(--sideBd-color); }
            #tab-list { display: flex; overflow-x: auto; }
            #tab-list li { white-space: nowrap; border-bottom: none; border-left: var(--sideBd-line) solid var(--sideBd-color); }
            #sitemap-date { display: none; }
        }
    </style>

    <script is:inline>
    (function() {
        var CACHE_KEY = 'sitemap_data_cache_v2';
        var postsData = [];
        var labelCounts = {};

        function loadSitemap() {
            var cached = localStorage.getItem(CACHE_KEY);
            if (cached) {
                try { var parsed = JSON.parse(cached); postsData = parsed.posts; labelCounts = parsed.counts; renderTabs(); } catch(e) {}
            }
            fetch('https://www.alikernel.com/feeds/posts/summary?alt=json&max-results=500')
                .then(function(r) { return r.json(); })
                .then(function(json) { processData(json); })
                .catch(function() {});
        }

        function processData(json) {
            var entries = json.feed.entry;
            if (!entries) return;
            var newPosts = [], newCounts = {}, now = new Date();
            for (var i = 0; i < entries.length; i++) {
                var e = entries[i];
                var title = e.title.$t, url = '';
                for (var j = 0; j < e.link.length; j++) {
                    if (e.link[j].rel === 'alternate') { url = e.link[j].href; break; }
                }
                var pub = new Date(e.published.$t);
                var isNew = (now - pub) / 86400000 <= 3;
                var date = pub.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
                var labels = [];
                if (e.category) {
                    for (var k = 0; k < e.category.length; k++) {
                        var l = e.category[k].term;
                        labels.push(l);
                        newCounts[l] = (newCounts[l] || 0) + 1;
                    }
                }
                newPosts.push({ title: title, url: url, date: date, labels: labels, isNew: isNew });
            }
            localStorage.setItem(CACHE_KEY, JSON.stringify({ posts: newPosts, counts: newCounts }));
            if (JSON.stringify(postsData) !== JSON.stringify(newPosts)) {
                postsData = newPosts; labelCounts = newCounts; renderTabs();
            }
        }

        function renderTabs() {
            var tabList = document.getElementById('tab-list');
            if (!tabList) return;
            tabList.innerHTML = '';
            var cats = Object.keys(labelCounts).sort();
            cats.forEach(function(cat, idx) {
                var li = document.createElement('li');
                li.innerHTML = '<span>' + cat + '</span><span class="count-badge">' + labelCounts[cat] + '</span>';
                li.setAttribute('data-label', cat);
                li.addEventListener('click', function() {
                    document.querySelectorAll('#tab-list li').forEach(function(el) { el.classList.remove('active'); });
                    this.classList.add('active');
                    renderPosts(this.getAttribute('data-label'));
                });
                tabList.appendChild(li);
                if (idx === 0) { li.classList.add('active'); renderPosts(cat); }
            });
        }

        function renderPosts(filter) {
            var titleList = document.getElementById('post-list-titles');
            var dateList = document.getElementById('post-list-dates');
            if (!titleList || !dateList) return;
            titleList.innerHTML = ''; dateList.innerHTML = '';
            postsData.forEach(function(post) {
                if (post.labels.indexOf(filter) !== -1) {
                    var liT = document.createElement('li');
                    liT.className = 'post-item-row';
                    var badge = post.isNew ? '<span class="new-tag">جديد</span>' : '';
                    liT.innerHTML = '<a class="post-link" href="' + post.url + '">' + post.title + '</a>' + badge;
                    titleList.appendChild(liT);
                    var liD = document.createElement('li');
                    liD.className = 'post-item-row';
                    liD.innerHTML = '<span class="date-text">' + post.date + '</span>';
                    dateList.appendChild(liD);
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadSitemap);
        } else {
            loadSitemap();
        }
    })();

    function setTheme(theme, animate) {
        function applyTheme() {
            document.body.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            document.querySelectorAll('.theme-btn').forEach(function(btn) { btn.classList.remove('active'); });
            if (theme === 'dark') document.getElementById('theme-btn-dark').classList.add('active');
            else if (theme === 'light') document.getElementById('theme-btn-light').classList.add('active');
            else document.getElementById('theme-btn-system').classList.add('active');
        }
        if (!animate || !document.startViewTransition) { applyTheme(); return; }
        try {
            var btn = document.activeElement;
            var x = window.innerWidth/2, y = window.innerHeight/2;
            if (btn && btn.classList && btn.classList.contains('theme-btn')) {
                var r = btn.getBoundingClientRect();
                x = r.left + r.width/2; y = r.top + r.height/2;
            }
            var radius = Math.hypot(Math.max(x, window.innerWidth-x), Math.max(y, window.innerHeight-y));
            var transition = document.startViewTransition(applyTheme);
            transition.ready.then(function() {
                document.documentElement.animate(
                    { clipPath: ['circle(0px at '+x+'px '+y+'px)', 'circle('+radius+'px at '+x+'px '+y+'px)'] },
                    { duration: 800, easing: 'ease-out', pseudoElement: '::view-transition-new(root)' }
                );
            });
        } catch(e) { applyTheme(); }
    }
    var savedTheme = localStorage.getItem('theme') || 'default';
    setTheme(savedTheme, false);
    </script>
</body>
</html>
