---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---
<Layout title="نبذة عن الكاتب">
    <div class="aboutAuthor">
        <div class="aboutCont">
            <Logo class="authorLogo" />

            <p>مرحباً، أنا <strong>علي الأسدي</strong>، متخصص في التكنولوجيا ومطور أكواد لمنصات بلوجر.
أنا من بغداد، العراق، وأقيم حالياً في سان خوسيه، كاليفورنيا، قلب وادي السيليكون، حيث تنبض أحدث ابتكارات عالم التكنولوجيا.
أعمل على تقديم آخر الأخبار في مجال التكنولوجيا، وأشارك خبراتي ومعرفتي من خلال مدونتي.
كما أنني مهتم بتطوير وتحسين أكواد بلوجر، مما يساعد في إنشاء مواقع أكثر فعالية وجاذبية.
بالإضافة إلى ذلك، أقدم حلولاً عملية لمشاكل الكمبيوتر والهواتف الذكية، مما يسهل على المستخدمين التغلب على التحديات التقنية اليومية.
مع خبرة واسعة في عالم التكنولوجيا والبرمجة، أهدف إلى جعل المعلومات التقنية في متناول الجميع، سواء كانوا محترفين أو هواة.
انضم إليّ في هذه الرحلة التقنية لاكتشاف أحدث التطورات والابتكارات في عالم التكنولوجيا.</p>

            <div class="athrBtn">
                <a class="athr-btn" href="https://draft.blogger.com/profile/16158558893347429492" target="_blank">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="6" r="4"/>
                        <path d="M20 17.5c0 2.485 0 4.5-8 4.5s-8-2.015-8-4.5S7.582 13 12 13s8 2.015 8 4.5"/>
                    </svg>
                    الملف الشخصي
                </a>
            </div>
        </div>
    </div>

    <h3 class="statsHeading">إحصائيات المدونة</h3>

    <div class="statsWebsite">
        <div class="statsCont">
            <div class="stats">
                <div class="statsName">
                    <svg class="line" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <g transform="translate(2.000000, 2.000000)">
                            <path d="M10.0002,0.7501 C3.0632,0.7501 0.7502,3.0631 0.7502,10.0001 C0.7502,16.9371 3.0632,19.2501 10.0002,19.2501 C16.9372,19.2501 19.2502,16.9371 19.2502,10.0001"/>
                            <path d="M17.5285,2.3038 L17.5285,2.3038 C16.5355,1.4248 15.0185,1.5168 14.1395,2.5098 C14.1395,2.5098 9.7705,7.4448 8.2555,9.1578 C6.7385,10.8698 7.8505,13.2348 7.8505,13.2348 C7.8505,13.2348 10.3545,14.0278 11.8485,12.3398 C13.3435,10.6518 17.7345,5.6928 17.7345,5.6928 C18.6135,4.6998 18.5205,3.1828 17.5285,2.3038 Z"/>
                            <path d="M12.4412,12.4412 L10.0002,10.0002 L10.0002,5.2632"/>
                        </g>
                    </svg>
                    المواضيع المنشورة
                </div>
                <div class="statsNumber" id="posts-count">...</div>
            </div>
        </div>

        <div class="statsCont">
            <div class="stats">
                <div class="statsName">
                    <svg class="line" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8,13 L16,13"/>
                        <path d="M8,9 L12,9"/>
                        <path d="M16.5,21.5 C16.5,21.5 12,21.5 12,21.5 C6,21.5 2.5,18 2.5,12 C2.5,6 6,2.5 12,2.5 C18,2.5 21.5,6 21.5,12 C21.5,13.626 21.054,15.118 20.3,16.386 C19.646,17.485 19.866,18.89 20.575,19.835 C20.941,20.324 20.551,20.973 19.931,20.893 C18.73,20.738 17.47,21.026 16.5,21.5 Z"/>
                    </svg>
                    التعليقات
                </div>
                <div class="statsNumber" id="comments-count">...</div>
            </div>
        </div>
    </div>

    <style is:global>
        .aboutAuthor { margin-bottom: 20px; }
        .authorLogo { width: 120px; height: 120px; position: absolute; border-radius: 50%; top: -60px; left: 50%; transform: translateX(-50%); box-shadow: 0 5px 20px rgba(0,0,0,.2); border: 7px solid var(--postBg); }
        .aboutCont p { margin: 0; text-align: justify; font-size: 15px; color: var(--themeC-alt); line-height: 1.8; }
        .athrBtn { text-align: center; position: absolute; bottom: 0; left: 0; right: 0; }
        .athr-btn { display: inline-flex; align-items: center; gap: 8px; border-radius: 8px; margin: 0 0 30px; padding: 8px 20px; background-color: var(--alikernelBg); color: var(--alikernelC); font-size: 14px; font-weight: 600; border: 1px solid var(--sideBd-color); transition: opacity .2s; }
        .athr-btn:hover { opacity: .85; }
        .aboutCont { background-color: var(--postBg); padding: 80px 30px 90px; border-radius: 12px; margin-top: 60px; position: relative; border: var(--sideBd-line) solid var(--sideBd-color); display: flex; flex-direction: column; gap: 12px; }
        .statsHeading { font-size: 18px; margin-bottom: 20px; font-weight: 600; }
        .statsWebsite { display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 20px; }
        .statsCont {
            background-color: var(--postBg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            border: var(--sideBd-line) solid var(--sideBd-color);
            border-radius: 8px; flex-grow: 1;
        }
        .stats { height: 80px; width: 200px; display: flex; align-items: center; justify-content: center; flex-direction: column; margin: 0 35px; }
        .statsName { display: inline-flex; align-items: center; font-size: 14px; color: var(--themeC-alt); }
        .statsName svg { margin-left: 9px; width: 20px; height: 20px; }
        .statsNumber { font-size: 27px; margin-top: 5px; font-weight: 600; color: var(--themeLink); }
        @media screen and (min-width: 400px) { .statsCont { min-width: 200px; } }
    </style>

    <script is:inline>
    function loadStats() {
        fetch('https://www.alikernel.com/feeds/posts/summary?alt=json&max-results=1')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var el = document.getElementById('posts-count');
                if (el) el.textContent = data.feed.openSearch$totalResults.$t;
            }).catch(function() {});
        fetch('https://www.alikernel.com/feeds/comments/default?alt=json&max-results=1')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var el = document.getElementById('comments-count');
                if (el) el.textContent = data.feed.openSearch$totalResults.$t;
            }).catch(function() {});
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', loadStats); } else { loadStats(); }
    </script>
</Layout>
