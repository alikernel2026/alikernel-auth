---
import Layout from '../layouts/Layout.astro';
import '../styles/style.css';
---

<Layout title="حسابي">

<div class="account-container">

    <div class="account-header">
        <h2>حساب</h2>
        <p>عرض وإدارة حسابك</p>
    </div>

    <section class="user-details">
        <div class="user-info">
            <h3 id="account-name">...</h3>
            <p id="account-email"></p>
            <p id="account-joined-date"></p>
        </div>
        <img id="account-avatar" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="صورة المستخدم">
    </section>

    <div class="sessions-title">الأجهزة المتصلة</div>
    <div class="sessions-list" id="sessions-list">
        <div class="loading-text">جاري التحميل...</div>
    </div>

    <div class="account-actions">
        <button class="account-btn primary" id="logout-btn">
            <span>الخروج</span>
        </button>
        <a href="https://www.alikernel.com" class="account-btn secondary">
            <span>الرئيسية</span>
        </a>
    </div>

</div>

<script is:inline>
(function() {
    var API = "/api/auth";
    var LOGIN = "/login";
    var currentSessionToken = null;

    function getOS(userAgent) {
        if (!userAgent) return "غير معروف";
        if (/Android/i.test(userAgent)) return "أندرويد";
        if (/iPhone/i.test(userAgent)) return "آيفون";
        if (/Windows/i.test(userAgent)) return "ويندوز";
        if (/Mac/i.test(userAgent)) return "ماك";
        if (/Linux/i.test(userAgent)) return "لينكس";
        return "غير معروف";
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    fetch(API + "/get-session", { credentials: "include" })
        .then(r => r.json())
        .then(data => {
            if (!data || !data.user) {
                window.location.href = LOGIN;
                return;
            }

            var user = data.user;
            currentSessionToken = data.session ? data.session.token : null;

            document.getElementById('account-name').textContent = user.name || "مستخدم";
            document.getElementById('account-email').textContent = user.email || "";

            if (user.image) {
                document.getElementById('account-avatar').src = user.image;
            }

            if (user.createdAt) {
                var date = new Date(user.createdAt);
                document.getElementById('account-joined-date').textContent =
                    "انضم في: " + date.toLocaleString('ar-u-nu-latn');
            }

            loadSessions();
        })
        .catch(() => window.location.href = LOGIN);

    function loadSessions() {
        var list = document.getElementById("sessions-list");

        fetch(API + "/list-sessions", { credentials: "include" })
            .then(r => r.json())
            .then(sessions => {
                if (!sessions || sessions.length === 0) {
                    list.innerHTML = '<p>لا توجد جلسات</p>';
                    return;
                }

                list.innerHTML = sessions.map(s => {
                    var isCurr = s.token === currentSessionToken;
                    return `
                        <div class="session-item">
                            <div>النظام: ${getOS(s.userAgent)}</div>
                            <div>IP: ${escapeHtml(s.ipAddress || '')}</div>
                            ${isCurr ? '<div>جلستك الحالية</div>' : ''}
                        </div>
                    `;
                }).join('');
            });
    }

    document.getElementById('logout-btn').addEventListener('click', function() {
        fetch(API + "/sign-out", {
            method: "POST",
            credentials: "include"
        }).then(() => {
            window.location.href = LOGIN;
        });
    });

})();
</script>

</Layout>
