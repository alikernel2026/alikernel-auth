---
import Layout from '../layouts/Layout.astro';
---

<Layout title="حسابي">
    <div class="account-container">

        <div class="account-header">
            <h2>حساب</h2>
            <p>عرض وإدارة حسابك</p>
        </div>

        <section class="user-details">
            <div class="user-info">
                <h3 id="account-name">...</h3>
                <p id="account-email"></p>
                <p id="account-joined-date"></p>
            </div>
            <img id="account-avatar" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="صورة المستخدم">
        </section>

        <div class="sessions-title">الأجهزة المتصلة</div>
        <div class="sessions-list" id="sessions-list">
            <div class="loading-text">جاري التحميل...</div>
        </div>

        <div class="account-actions">
            <button class="account-btn primary" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="scale(-1 1)"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4m7 14 5-5-5-5m5 5H9"/></svg>
                <span>الخروج</span>
            </button>
            <a href="https://www.alikernel.com" class="account-btn secondary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span>الرئيسية</span>
            </a>
        </div>

    </div>

    <style>
        /* ستايلات صفحة الحساب الخاصة (حتى ما يخرب التصميم) */
        .account-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 30px;
            background-color: var(--postBg);
            border: 1px solid var(--sideBd-color);
            border-radius: 12px;
        }
        .account-header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 1px solid var(--sideBd-color);
            padding-bottom: 20px;
        }
        .account-header h2 { color: var(--themeC); font-size: 26px; font-weight: 700; margin-bottom: 5px; }
        .account-header p { color: var(--themeC-alt); font-size: 15px; }

        .user-details {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: var(--contentBg-sec);
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 35px;
            border: 1px solid var(--sideBd-color);
        }
        .user-info h3 { color: var(--themeC); font-size: 22px; font-weight: 700; margin-bottom: 8px; }
        .user-info p { color: var(--themeC-alt); font-size: 15px; margin-bottom: 5px; }
        #account-avatar {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            border: 4px solid var(--themeBg);
            object-fit: cover;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .sessions-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--themeC);
            margin-bottom: 15px;
        }
        .sessions-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 35px;
        }
        .session-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background-color: var(--themeBg);
            border: 1px solid var(--sideBd-color);
            border-radius: 10px;
        }
        .session-details { display: flex; flex-direction: column; gap: 10px; }
        .session-detail-line {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: var(--themeC-alt);
        }
        .session-detail-line svg { color: var(--themeLink); }
        .current-session-indicator { color: #10b981; font-weight: 600; }
        .current-session-indicator svg { color: #10b981; }

        .terminate-btn {
            width: 45px;
            height: 45px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            transition: all 0.2s;
        }
        .terminate-btn:hover { background-color: #ef4444; color: #fff; }
        .terminate-btn.icon-terminate::before {
            content: '';
            display: block;
            width: 20px;
            height: 20px;
            background-image: url('data:image/svg+xml;utf8,<svg viewBox="0 0 24 24" fill="none" stroke="%23ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>');
            background-size: cover;
        }
        .terminate-btn:hover.icon-terminate::before {
            background-image: url('data:image/svg+xml;utf8,<svg viewBox="0 0 24 24" fill="none" stroke="%23ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>');
        }
        
        .terminate-btn.icon-current { 
            background-color: rgba(16, 185, 129, 0.1); 
            color: #10b981; 
            pointer-events: none; 
        }
        .terminate-btn.icon-current::before {
            content: '';
            display: block;
            width: 20px;
            height: 20px;
            background-image: url('data:image/svg+xml;utf8,<svg viewBox="0 0 24 24" fill="none" stroke="%2310b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>');
            background-size: cover;
        }

        .account-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
        }
        .account-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            transition: all 0.2s;
        }
        .account-btn.primary { background-color: #ef4444; color: white; }
        .account-btn.primary:hover { background-color: #dc2626; opacity: 0.9; }
        .account-btn.secondary { background-color: transparent; border: 1px solid var(--sideBd-color); color: var(--themeC); }
        .account-btn.secondary:hover { background-color: var(--contentBg-sec); }
        .account-btn svg { width: 18px; height: 18px; }
        
        @media (max-width: 600px) {
            .user-details { flex-direction: column; text-align: center; gap: 20px; }
            .session-item { flex-direction: column; align-items: flex-start; gap: 20px; }
            .terminate-btn { align-self: flex-end; }
        }
    </style>

    <script is:inline>
    var icons = {
        clock: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle></svg>',
        device: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8"></path><rect width="6" height="10" x="16" y="12" rx="2"></rect></svg>',
        location: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>',
        globe: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M7.99998 3H8.99998C7.04998 8.84 7.04998 15.16 8.99998 21H7.99998"></path><path d="M15 3C16.95 8.84 16.95 15.16 15 21"></path><path d="M3 16V15C8.84 16.95 15.16 16.95 21 15V16"></path><path d="M3 9C8.84 7.05 15.16 7.05 21 9"></path></svg>',
        check: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4L9 15"></path><path d="M21 19L3 19"></path><path d="M9 15L4 10"></path></svg>'
    };

    function getOS(userAgent) {
        if (!userAgent) return "غير معروف";
        if (/Android/i.test(userAgent)) return "أندرويد";
        if (/iPhone/i.test(userAgent)) return "آيفون";
        if (/iPad/i.test(userAgent)) return "آيباد";
        if (/Windows/i.test(userAgent)) return "ويندوز";
        if (/Mac/i.test(userAgent)) return "ماك";
        if (/Linux/i.test(userAgent)) return "لينكس";
        return "غير معروف";
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    (function() {
        if (!localStorage.getItem('last_uid')) {
            document.documentElement.style.visibility = 'hidden';
        }

        var API = "/api/auth";
        var LOGIN = "/login";
        var currentSessionToken = null;

        window.addEventListener('storage', function(e) {
            if (e.key === 'auth_event' && (e.newValue || '').startsWith('signout')) {
                localStorage.clear();
                window.location.href = LOGIN;
            }
        });

        try {
            var photoURL = localStorage.getItem("userPhotoURL");
            var lastUid = localStorage.getItem("last_uid");
            var av = document.getElementById("account-avatar");
            if (lastUid && photoURL && av) av.src = photoURL;
            var cachedName = localStorage.getItem("userDisplayName");
            var cachedEmail = localStorage.getItem("userEmail");
            var cachedJoined = localStorage.getItem("userJoinedDate");
            var cachedSessions = localStorage.getItem("userSessionsHTMLCache");
            if (cachedName) document.getElementById("account-name").textContent = cachedName;
            if (cachedEmail) document.getElementById("account-email").textContent = cachedEmail;
            if (cachedJoined) document.getElementById("account-joined-date").textContent = cachedJoined;
            if (cachedSessions) document.getElementById("sessions-list").innerHTML = cachedSessions;
        } catch(e) {}

        fetch(API + "/get-session", { credentials: "include" })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data || !data.user) { window.location.href = LOGIN; return; }
                var user = data.user;
                currentSessionToken = data.session ? data.session.token : null;
                var name = user.name || "مستخدم";
                var email = user.email || "";
                document.getElementById('account-name').textContent = name;
                document.getElementById('account-email').textContent = email;
                if (user.image) {
                    document.getElementById('account-avatar').src = user.image;
                    localStorage.setItem("userPhotoURL", user.image);
                }
                var prevUid = localStorage.getItem("last_uid");
                localStorage.setItem("userDisplayName", name);
                localStorage.setItem("userEmail", email);
                localStorage.setItem("last_uid", user.id);
                if (!prevUid) {
                    localStorage.setItem('auth_event', 'signin_' + Date.now());
                    setTimeout(function() { window.location.href = 'https://www.alikernel.com'; }, 300);
                    return;
                }
                document.documentElement.style.visibility = 'visible';
                if (user.createdAt) {
                    var date = new Date(user.createdAt);
                    var formatted = "انضم في: " + date.toLocaleString('ar-u-nu-latn', {
                        year: 'numeric', month: 'numeric', day: 'numeric',
                        hour: 'numeric', minute: 'numeric', hour12: true
                    }).replace('ص', 'صباحاً').replace('م', 'مساءً');
                    document.getElementById('account-joined-date').textContent = formatted;
                    localStorage.setItem("userJoinedDate", formatted);
                }
                loadSessions();
            })
            .catch(function() { window.location.href = LOGIN; });

        function loadSessions() {
            var list = document.getElementById("sessions-list");
            if (!list) return;
            fetch(API + "/list-sessions", { credentials: "include" })
                .then(function(r) { return r.json(); })
                .then(function(sessions) {
                    if (!sessions || sessions.length === 0) {
                        list.innerHTML = '<p style="text-align:center;color:#888;">لا توجد جلسات نشطة</p>';
                        return;
                    }
                    var htmlContent = sessions.map(function(s) {
                        var isCurr = s.token === currentSessionToken;
                        var time = new Date(s.createdAt).toLocaleString('ar-u-nu-latn', {
                            hour: 'numeric', minute: 'numeric', hour12: true
                        }).replace('ص', 'AM').replace('م', 'PM');
                        var os = getOS(s.userAgent);
                        var domainLine = s.userAgent ?
                            '<div class="session-detail-line">' + icons.globe + ' <span>الموقع: ' + escapeHtml(window.location.hostname) + '</span></div>' : '';

                        return '<div class="session-item" id="session-' + escapeHtml(s.token) + '">' +
                            '<div class="session-details">' +
                                '<div class="session-detail-line">' + icons.clock + ' <span>الوقت: ' + time + '</span></div>' +
                                '<div class="session-detail-line">' + icons.device + ' <span>نظام التشغيل: ' + os + '</span></div>' +
                                '<div class="session-detail-line">' + icons.location + ' <span>العنوان: ' + escapeHtml(s.ipAddress || 'غير معروف') + '</span></div>' +
                                domainLine +
                                (isCurr ? '<div class="session-detail-line current-session-indicator">' + icons.check + ' <span>جلستك الحالية</span></div>' : '') +
                            '</div>' +
                            '<button class="terminate-btn ' + (isCurr ? 'icon-current' : 'icon-terminate') + '" onclick="deleteSession(\'' + escapeHtml(s.token) + '\', ' + isCurr + ')"></button>' +
                        '</div>';
                    }).join('');

                    localStorage.setItem("userSessionsHTMLCache", htmlContent);
                    list.innerHTML = htmlContent;
                })
                .catch(function() {
                    list.innerHTML = '<p style="text-align:center;color:#888;">تعذر تحميل الجلسات</p>';
                });
        }

        window.deleteSession = function(token, isCurrent) {
            var msg = isCurrent ? "لا يمكن التراجع عن هذا الإجراء. أنت على وشك إلغاء جلستك الحالية، مما سيؤدي إلى تسجيل خروجك فوراً." : "لا يمكن التراجع عن هذا الإجراء. سيؤدي إلغاء هذه الجلسة إلى إزالة صلاحيات الوصول الخاصة بها.";
            
            if (typeof window.showModal === "function") {
                window.showModal(msg, function() {
                    executeDelete(token, isCurrent);
                });
            } else {
                if (confirm(msg)) executeDelete(token, isCurrent);
            }
        };

        function executeDelete(token, isCurrent) {
            fetch(API + "/revoke-session", {
                method: "POST",
                credentials: "include",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ token: token })
            }).then(function() {
                if (isCurrent) {
                    localStorage.setItem('auth_event', 'signout_' + Date.now());
                    localStorage.clear();
                    window.location.href = LOGIN;
                } else {
                    loadSessions();
                }
            });
        }

        document.getElementById('logout-btn').addEventListener('click', function() {
            var msg = "هل تريد تسجيل الخروج؟";
            var cb = function() {
                fetch(API + "/sign-out", {
                    method: "POST",
                    credentials: "include",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({})
                }).then(function() {
                    localStorage.setItem('auth_event', 'signout_' + Date.now());
                    setTimeout(function() {
                        localStorage.clear();
                        window.location.href = LOGIN;
                    }, 300);
                });
            };
            
            if (typeof window.showModal === "function") {
                window.showModal(msg, cb);
            } else {
                if (confirm(msg)) cb();
            }
        });
    })();
    </script>
</Layout>
