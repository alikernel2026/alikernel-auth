---
import '../styles/style.css';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حسابي - علي كيرنل</title>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon-96x96.png?raw=true' rel='icon' sizes='96x96' type='image/png'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.svg?raw=true' rel='icon' type='image/svg+xml'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/favicon.ico?raw=true' rel='shortcut icon'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/apple-touch-icon.png?raw=true' rel='apple-touch-icon' sizes='180x180'/>
    <link href='https://github.com/alikernel2026/favicon.ico/blob/main/site.webmanifest?raw=true' rel='manifest'/>
    <style>
        ::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
        ::view-transition-new(root){z-index:2}

        /* --- الشعار: يتغير مع الثيم --- */
        .ak-logo-bg { fill: #94f27f; }
        .ak-logo-fg { fill: #000000; }
        [data-theme="light"] .ak-logo-bg { fill: #1976d2; }
        [data-theme="light"] .ak-logo-fg { fill: #ffffff; }
        @media (prefers-color-scheme: light) {
            [data-theme="default"] .ak-logo-bg { fill: #1976d2; }
            [data-theme="default"] .ak-logo-fg { fill: #ffffff; }
        }

        /* تعديل المودال فقط ليكون بحاويتين */
        .custom-modal-content {
            background-color: var(--postBg);
            width: 90%;
            max-width: 400px;
            border-radius: 14px;
            overflow: hidden;
            border: var(--sideBd-line) solid var(--sideBd-color);
            display: flex;
            flex-direction: column;
            padding: 0 !important; /* إلغاء البادينج الرئيسي لتقسيم الحاويات */
        }
        .modal-body {
            padding: 25px 20px;
        }
        .modal-footer {
            background-color: rgba(0, 0, 0, 0.2); /* الحاوية الثانية للأزرار */
            padding: 15px 20px;
            border-top: 1px solid var(--sideBd-color);
        }
        .custom-modal-actions {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-start;
            gap: 10px;
        }
    </style>
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.documentElement.setAttribute('data-theme', theme);
            if (!localStorage.getItem('last_uid')) {
                document.documentElement.style.visibility = 'hidden';
            }
        })();
    </script>
</head>
<body data-theme="dark">

    <div class="page-wrapper">

        <header class="site-header">
            <div class="header-content">
                <a href="https://www.alikernel.com" class="header-logo-link">
                    <svg class="header-logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4667.08 4667.08">
                        <rect class="ak-logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                        <path class="ak-logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                        <path class="ak-logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                    </svg>
                    <span>علي كيرنل</span>
                </a>
            </div>
        </header>

        <main class="page-content">
            <div class="account-container">
                <div class="account-header">
                    <h2>حساب</h2>
                    <p>عرض وإدارة حسابك</p>
                </div>

                <section class="user-details">
                    <div class="user-info">
                        <h3 id="account-name">...</h3>
                        <p id="account-email"></p>
                        <p id="account-joined-date"></p>
                    </div>
                    <img id="account-avatar" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="صورة المستخدم">
                </section>

                <div class="sessions-title">الأجهزة المتصلة</div>
                <div class="sessions-list" id="sessions-list">
                    <div class="loading-text">جاري التحميل...</div>
                </div>

                <div class="account-actions">
                    <button class="account-btn primary" id="logout-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="scale(-1 1)"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4m7 14 5-5-5-5m5 5H9"/></svg>
                        <span>الخروج</span>
                    </button>
                    <a href="https://www.alikernel.com" class="account-btn secondary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                        <span>الرئيسية</span>
                    </a>
                </div>
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-logo-section">
                    <a href="https://www.alikernel.com" class="footer-logo-link">
                        <svg class="footer-logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4667.08 4667.08">
                            <rect class="ak-logo-bg" width="4667.08" height="4667.08" rx="1004" ry="1004"/>
                            <path class="ak-logo-fg" d="M2055.99,2617.1h404.27c.56,0,1.08.26,1.4.71l291.49,401.96c.59.78.42,1.88-.35,2.46-.32.24-.71.36-1.11.35h-994.49c-.56,0-1.08.26-1.4.71l-165.46,226.36c-.33.45-.85.71-1.4.71l-682.1,1c-.97,0-1.76-.79-1.76-1.76,0-.38.13-.75.35-1.05l1339.51-1832.1c.33-.45.85-.71,1.4-.71h680.2c.97,0,1.76.79,1.76,1.76,0,.38-.13.75-.35,1.05l-873.37,1195.74c-.58.78-.42,1.88.35,2.46.3.23.68.35,1.05.35h0Z"/>
                            <path class="ak-logo-fg" d="M3092.35,2332.03l667.24,916.6c.5.67.36,1.61-.3,2.11-.26.19-.58.3-.91.3h-678.14c-.47,0-.92-.22-1.2-.6l-674.73-921.43c-.4-.53-.4-1.27,0-1.81l673.17-910.88c.28-.38.73-.6,1.2-.6h681.81c.83,0,1.51.68,1.51,1.51,0,.33-.1.65-.3.91l-669.35,912.09c-.4.53-.4,1.27,0,1.81h0Z"/>
                        </svg>
                        <span>علي كيرنل</span>
                    </a>
                    <a href="https://www.alikernel.com/p/privacy.html">الخصوصية</a>
                    <a href="https://www.alikernel.com/p/terms.html">الشروط</a>
                </div>

                <div class="theme-controls">
                    <button class="theme-btn" id="theme-btn-dark" onclick="setTheme('dark', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M19 3v4"/><path d="M21 5h-4"/></svg>
                    </button>
                    <button class="theme-btn" id="theme-btn-light" onclick="setTheme('light', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
                    </button>
                    <button class="theme-btn" id="theme-btn-system" onclick="setTheme('default', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    </button>
                </div>
            </div>
        </footer>

    </div>

    <div id="custom-confirm-modal" class="custom-modal-overlay hidden">
        <div class="custom-modal-content">
            <div class="modal-body">
                <h2 id="modal-title">هل أنت متأكد؟</h2>
                <p id="custom-modal-text"></p>
            </div>
            <div class="modal-footer">
                <div class="custom-modal-actions">
                    <button id="custom-modal-confirm-btn" class="modal-btn primary">استمرار</button>
                    <button id="custom-modal-cancel-btn" class="modal-btn secondary">إلغاء</button>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
    // الدوال الخاصة بالثيم والجلسات (نفس كودك الأصلي)
    function setTheme(theme, animate) {
        function applyTheme() {
            document.body.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            document.querySelectorAll('.theme-btn').forEach(function(btn) { btn.classList.remove('active'); });
            if (theme === 'dark') document.getElementById('theme-btn-dark').classList.add('active');
            else if (theme === 'light') document.getElementById('theme-btn-light').classList.add('active');
            else document.getElementById('theme-btn-system').classList.add('active');
        }
        if (!animate || !document.startViewTransition) { applyTheme(); return; }
        document.startViewTransition(applyTheme);
    }
    setTheme(localStorage.getItem('theme') || 'default', false);

    function showModal(msg, cb) {
        var modal = document.getElementById("custom-confirm-modal");
        var text = document.getElementById("custom-modal-text");
        var confirmBtn = document.getElementById("custom-modal-confirm-btn");
        var cancelBtn = document.getElementById("custom-modal-cancel-btn");
        text.textContent = msg;
        modal.classList.remove("hidden");
        confirmBtn.onclick = function() { modal.classList.add("hidden"); if (cb) cb(); };
        cancelBtn.onclick = function() { modal.classList.add("hidden"); };
    }

    (function() {
        var API = "/api/auth";
        var LOGIN = "/login";
        fetch(API + "/get-session", { credentials: "include" })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data || !data.user) { window.location.href = LOGIN; return; }
                document.getElementById('account-name').textContent = data.user.name;
                document.getElementById('account-email').textContent = data.user.email;
                if (data.user.image) document.getElementById('account-avatar').src = data.user.image;
                document.documentElement.style.visibility = 'visible';
                loadSessions();
            }).catch(function() { window.location.href = LOGIN; });

        function loadSessions() {
            var list = document.getElementById("sessions-list");
            fetch(API + "/list-sessions", { credentials: "include" })
                .then(function(r) { return r.json(); })
                .then(function(sessions) {
                    list.innerHTML = sessions.map(function(s) {
                        return '<div class="session-item"><span>' + s.userAgent + '</span><button onclick="deleteSession(\'' + s.token + '\')">إزالة</button></div>';
                    }).join('');
                });
        }
        
        document.getElementById('logout-btn').addEventListener('click', function() {
            showModal("هل تريد تسجيل الخروج؟", function() {
                fetch(API + "/sign-out", { method: "POST", credentials: "include" })
                .then(function() { localStorage.clear(); window.location.href = LOGIN; });
            });
        });
    })();
    </script>
</body>
</html>
