---
import '../styles/style.css';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حسابي - علي كيرنل</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body data-theme="dark">

    <div class="page-wrapper">
        <header class="site-header">
            <div class="header-content">
                <a href="https://www.alikernel.com" class="header-logo-link">
                    <svg class="header-logo-icon" viewBox="0 0 124 124" fill="none">
                        <rect width="124" height="124" rx="24" fill="#F97316"/>
                        <path d="M19.375 36.782v63.843a4 4 0 0 0 4 4h63.843c3.564 0 5.348-4.309 2.829-6.828L26.203 33.953c-2.52-2.52-6.828-.735-6.828 2.829" fill="#fff"/>
                        <circle cx="63.211" cy="37.539" r="18.164" fill="#000"/>
                    </svg>
                    <span>علي كيرنل</span>
                </a>
            </div>
        </header>

        <main class="page-content">
            <div class="account-container">
                <div class="account-header">
                    <h2>حساب</h2>
                    <p>عرض وإدارة حسابك</p>
                </div>

                <section class="user-details">
                    <div class="user-info">
                        <h3 id="account-name">جاري التحميل...</h3>
                        <p id="account-email"></p>
                        <p id="account-joined-date"></p>
                    </div>
                    <img id="account-avatar" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="صورة المستخدم">
                </section>

                <div class="sessions-title">الأجهزة المتصلة</div>
                <div class="sessions-list" id="sessions-list">
                    <div class="loading-text">جاري التحميل...</div>
                </div>

                <div class="account-actions">
                    <button class="account-btn primary" id="logout-btn">
                        <span>تسجيل الخروج</span>
                    </button>
                    <a href="https://www.alikernel.com" class="account-btn secondary">
                        <span>الرئيسية</span>
                    </a>
                </div>
            </div>
        </main>

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-logo-section">
                    <a href="https://www.alikernel.com" class="footer-logo-link"><span>علي كيرنل</span></a>
                </div>
            </div>
        </footer>
    </div>

    <div id="custom-confirm-modal" class="custom-modal-overlay hidden">
        <div class="custom-modal-content">
            <p id="custom-modal-text"></p>
            <div class="custom-modal-actions">
                <button id="custom-modal-cancel-btn" class="modal-btn secondary">إلغاء</button>
                <button id="custom-modal-confirm-btn" class="modal-btn primary">تأكيد</button>
            </div>
        </div>
    </div>

    <script>
        import { createAuthClient } from "better-auth/client";
        const authClient = createAuthClient({ baseURL: "https://www.alikernel.com" });

        // نافذة التأكيد
        function showModal(msg, cb) {
            const modal = document.getElementById("custom-confirm-modal");
            document.getElementById("custom-modal-text").textContent = msg;
            modal.classList.remove("hidden");
            document.getElementById("custom-modal-confirm-btn").onclick = () => {
                modal.classList.add("hidden");
                if (cb) cb();
            };
            document.getElementById("custom-modal-cancel-btn").onclick = () => modal.classList.add("hidden");
        }

        // جلب البيانات عند الدخول
        async function init() {
            const { data, error } = await authClient.getSession();
            if (!data) {
                window.location.href = "/login";
                return;
            }

            document.getElementById('account-name').textContent = data.user.name;
            document.getElementById('account-email').textContent = data.user.email;
            if (data.user.image) document.getElementById('account-avatar').src = data.user.image;
        }

        // زر تسجيل الخروج (التصحيح الرئيسي)
        document.getElementById('logout-btn').addEventListener('click', () => {
            showModal("هل تريد تسجيل الخروج؟", async () => {
                await authClient.signOut({
                    fetchOptions: {
                        onSuccess: () => {
                            localStorage.clear();
                            window.location.href = "/login";
                        }
                    }
                });
            });
        });

        init();
    </script>
</body>
</html>
