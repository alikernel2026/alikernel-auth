---
// تأكد أن ملف Layout.astro يحتوي على <meta charset="utf-8" />
---

<div class='tNtf alt' id="toastNotif"></div>

<div id="__icons_wrapper" class="icon-manager-root" dir="rtl">
    <div class="top-info">انقر على الأيقونة لنسخ كود SVG الخاص بها.</div>
    
    <div class="search-box-container">
        <input type="text" id="iconSearchInput" placeholder="ابحث بين 919 أيقونة..." />
    </div>

    <div id="iconsGridContainer" class="icons-grid">
        <p class="loading-msg">جاري تحميل الأيقونات...</p>
    </div>
</div>

<style is:global>
    /* الخط العربي */
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500&display=swap');

    .icon-manager-root {
        font-family: 'Noto Sans Arabic', sans-serif;
        background-color: #0c0c0c; /* لون الخلفية الغامق من الصورة */
        padding: 20px;
        color: #fff;
    }

    .top-info {
        color: #888;
        font-size: 14px;
        margin-bottom: 20px;
    }

    /* صندوق البحث - نفس شكل الصورة الثانية */
    .search-box-container {
        margin-bottom: 25px;
    }

    #iconSearchInput {
        width: 100%;
        background: #161616;
        border: 1px solid #222;
        border-radius: 8px;
        padding: 18px 25px;
        color: #fff;
        font-size: 15px;
        outline: none;
        transition: border 0.3s;
    }

    #iconSearchInput:focus {
        border-color: #333;
    }

    /* الشبكة - 8 أعمدة كما طلبت */
    .icons-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(115px, 1fr));
        gap: 12px;
    }

    /* المربع الصغير (Icon Box) */
    .icon-box {
        position: relative;
        background: #111111;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        aspect-ratio: 1/1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .icon-box:hover {
        border-color: #4ade80; /* اللون الأخضر عند التحديد من الصورة */
        background: #141414;
    }

    /* الرقم الصغير */
    .icon-box::before {
        content: attr(data-index);
        position: absolute;
        top: 8px;
        left: 8px;
        font-size: 10px;
        color: #666;
        background: #1a1a1a;
        padding: 1px 5px;
        border-radius: 4px;
        border: 1px solid #222;
    }

    /* الأيقونة SVG - Linear */
    .icon-box svg {
        width: 32px;
        height: 32px;
        fill: none !important;
        stroke: #fff !important;
        stroke-width: 1.5;
        margin-bottom: 8px;
    }

    /* اسم الأيقونة */
    .icon-box span {
        font-size: 11px;
        color: #999;
        max-width: 90%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* التوست الأصلي */
    .tNtf {
        position: fixed;
        bottom: 25px;
        left: 25px;
        background: #ffffff;
        color: #000;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 500;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        z-index: 10000;
        display: none;
        animation: toast-in 0.3s ease;
    }

    @keyframes toast-in {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>

<script>
    // دالة التوست الأصلية
    function showToast(msg: string) {
        const toast = document.getElementById('toastNotif');
        if (toast) {
            toast.innerHTML = `<span>${msg}</span>`;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 2500);
        }
    }

    const initIcons = async () => {
        const grid = document.getElementById('iconsGridContainer');
        const search = document.getElementById('iconSearchInput') as HTMLInputElement;
        
        try {
            const response = await fetch("https://cdn.jsdelivr.net/gh/alicomputer7/919-icon-svg@latest/919%20icon%20svg.txt");
            const icons = await response.json();

            const render = (filter = "") => {
                if (!grid) return;
                const query = filter.toLowerCase().trim();
                const filtered = icons.filter((i: any) => i.code.toLowerCase().includes(query));
                
                grid.innerHTML = filtered.map((icon: any, idx: number) => `
                    <div class="icon-box" data-index="${icons.length - icons.indexOf(icon)}" data-svg='${icon.svg.replace(/'/g, "&apos;")}'>
                        ${icon.svg}
                        <span>${icon.code}</span>
                    </div>
                `).join('');

                // إضافة حدث النسخ
                grid.querySelectorAll('.icon-box').forEach(box => {
                    box.addEventListener('click', () => {
                        const svg = box.getAttribute('data-svg');
                        const name = box.querySelector('span')?.textContent;
                        if (svg) {
                            navigator.clipboard.writeText(svg);
                            showToast(`تم نسخ: ${name}`);
                        }
                    });
                });
            };

            search?.addEventListener('input', (e) => render((e.target as HTMLInputElement).value));
            render();

        } catch (err) {
            if (grid) grid.innerHTML = "خطأ في تحميل الأيقونات.";
        }
    };

    initIcons();
</script>
