---
// ملاحظة: تأكد من حفظ الملف بترميز UTF-8 في VS Code لتجنب تشفير الحروف
---

<div class='tNtf alt' id='toastNotif' style="display:none;"></div>

<div id="__icons_wrapper" class="blogger-style-root" dir="rtl">
  <div class="info-bar">انقر على الأيقونة لنسخ كود SVG الخاص بها.</div>
  
  <div class="search-wrapper">
    <input type="text" id="iconSearchInput" placeholder="ابحث بين 919 أيقونة..." />
  </div>

  <div id="iconsGrid" class="icons-grid-system">
    <p class="loading">جاري تحميل الأيقونات...</p>
  </div>
</div>

<style is:global>
  /* إجبار الخط العربي ومنع التشفير */
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500&display=swap');

  .blogger-style-root {
    font-family: 'Noto Sans Arabic', sans-serif;
    background-color: #0c0c0c; /* نفس لون خلفية بلوجر الداكن */
    padding: 20px;
    color: #eee;
  }

  .info-bar {
    color: #777;
    font-size: 14px;
    margin-bottom: 15px;
  }

  /* حقل البحث - نسخة طبق الأصل من بلوجر */
  .search-wrapper {
    margin-bottom: 20px;
  }

  #iconSearchInput {
    width: 100%;
    background: #151515;
    border: 1px solid #222;
    border-radius: 8px;
    padding: 18px 20px;
    color: #fff;
    font-size: 15px;
    outline: none;
  }

  /* الشبكة - 8 أعمدة أو حسب عرض الشاشة */
  .icons-grid-system {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 10px;
    counter-reset: num-icon;
  }

  /* المربع (Icon Box) */
  .icon-unit {
    counter-increment: num-icon;
    position: relative;
    background: #111;
    border: 1px solid #1a1a1a;
    border-radius: 8px;
    aspect-ratio: 1/1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .icon-unit:hover {
    border-color: #4ade80 !important; /* اللون الأخضر عند المرور من صورتك */
  }

  /* الرقم الصغير في الزاوية */
  .icon-unit::before {
    content: counter(num-icon);
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 10px;
    color: #555;
    background: #1a1a1a;
    padding: 1px 4px;
    border-radius: 3px;
    border: 1px solid #222;
  }

  /* أهم جزء: الأيقونة Linear (خطوط بيضاء) */
  .icon-unit svg {
    width: 32px;
    height: 32px;
    fill: none !important;
    stroke: #fff !important;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* اسم الأيقونة تحتها */
  .icon-unit span {
    font-size: 11px;
    color: #999;
    margin-top: 8px;
    max-width: 85%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* تنسيق التوست (tNtf) كما في صورتك */
  .tNtf {
    position: fixed;
    bottom: 25px;
    left: 25px;
    background: #ffffff;
    color: #111;
    padding: 12px 20px;
    border-radius: 8px;
    z-index: 10000;
    font-weight: 500;
    box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    font-size: 14px;
  }
</style>

<script>
  // دالة التوست الأصلية الخاصة بك مع إضافة التحويل لـ Block
  function toastNotif(t: string) {
    const n = document.getElementById('toastNotif');
    if (n) {
      n.innerHTML = "<span>" + t + "</span>";
      n.style.display = 'block';
      setTimeout(() => { n.style.display = 'none'; }, 2500);
    }
  }

  const startIconPicker = async () => {
    const grid = document.getElementById('iconsGrid');
    const search = document.getElementById('iconSearchInput') as HTMLInputElement;

    try {
      const res = await fetch("https://cdn.jsdelivr.net/gh/alicomputer7/919-icon-svg@latest/919%20icon%20svg.txt");
      const icons = await res.json();

      const render = (query = "") => {
        if (!grid) return;
        const q = query.toLowerCase().trim();
        const filtered = icons.filter((i: any) => i.code.toLowerCase().includes(q));
        
        grid.innerHTML = filtered.map((icon: any) => `
          <div class="icon-unit" data-svg='${icon.svg.replace(/'/g, "&apos;")}'>
            ${icon.svg}
            <span>${icon.code}</span>
          </div>
        `).join('');

        // أحداث النسخ
        grid.querySelectorAll('.icon-unit').forEach(box => {
          box.addEventListener('click', () => {
            const svg = box.getAttribute('data-svg');
            const name = box.querySelector('span')?.textContent;
            if (svg) {
              navigator.clipboard.writeText(svg);
              toastNotif(`تم نسخ: ${name}`);
            }
          });
        });
      };

      search?.addEventListener('input', (e) => render((e.target as HTMLInputElement).value));
      render();

    } catch (e) {
      if (grid) grid.innerHTML = "خطأ في الاتصال بالسيرفر.";
    }
  };

  startIconPicker();
</script>
