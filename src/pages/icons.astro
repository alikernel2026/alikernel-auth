---
// يمكنك إضافة أي Variables هنا إذا أردت تمريرها كـ Props
---

<div id="__icons" class="icons-wrapper">
  <p class="note">يتم تحميل الأيقونه. الرجاء الانتظار..</p>
</div>

<style is:global>
  /* ملاحظة: استخدمت is:global لأن بعض العناصر يتم إنشاؤها ديناميكياً بواسطة JS */
  .icons-container {
    counter-reset: num-icon;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 10px;
    padding: 10px 0;
  }

  .icons-container > * {
    counter-increment: num-icon;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border: var(--sideBd-line, 1px) solid var(--sideBd-color, #e5e7eb);
    border-radius: 7px;
    overflow: hidden;
    background-color: var(--headerBg, #f9fafb);
    color: var(--inputC, #111827);
    padding: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .icons-container > *::before {
    content: counter(num-icon);
    position: absolute;
    top: 5px;
    left: 5px;
    font-size: 10px;
    border-radius: 4px;
    padding: 0 3px;
    border: var(--buttonBd-line, 1px) solid var(--buttonBd-color, #d1d5db);
    background-color: var(--contentBg-sec, #ffffff);
  }

  .icons-container > * span {
    display: block;
    font-size: 11px;
    text-align: center;
    border: none;
    padding: 0;
    margin-top: 8px;
    opacity: .8;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 90%;
  }

  .icons-container > * svg {
    width: 35px;
    height: 35px;
  }

  .icons-container > *:hover {
    border-color: var(--themeLink, #3b82f6) !important;
    box-shadow: 0 0 0 0.5px var(--themeLink, #3b82f6) inset;
  }

  .icons-wrapper > * { margin: 0; }
  
  .icons-input {
    border: var(--sideBd-line, 1px) solid var(--sideBd-color, #e5e7eb);
    border-radius: 7px;
    background-color: var(--headerBg, #f9fafb);
    width: 100%;
    margin-bottom: 10px;
    padding: 20px;
    outline: 0;
  }

  .note {
    font-size: 14px;
    margin-bottom: 10px;
    color: var(--inputC, #374151);
  }
</style>

<script>
  // وظيفة وهمية للـ Toast في حال لم تكن معرفة في مشروعك
  const toastNotif = (msg: string) => {
    if (window.hasOwnProperty('toastNotif')) {
      // @ts-ignore
      window.toastNotif(msg);
    } else {
      alert(msg); // Fallback
    }
  };

  const renderUI = (target: HTMLElement, icons: any[]) => {
    target.innerHTML = `
      <p class="note">انقر على الأيقونة لنسخ كود SVG الخاص بها.</p>
      <div style="position: relative; display: flex; align-items: center;">
        <input placeholder="ابحث بين ${icons.length} أيقونه..." class="icons-input" id="__icons_input_query" type="text" style="width: 100%;"/>
        <button id="clear_search" style="position: absolute; left: 10px; top: 12px; background: transparent; border: none; cursor: pointer; display: none;">
          <svg viewBox='0 0 24 24' style='width: 33px; height: 33px; opacity: 0.5; color: var(--themeC-alt, #6b7280); fill: none; stroke: currentColor; stroke-width: 2;'>
            <path d='M18 6L6 18M6 6l12 12'></path>
          </svg>
        </button>
      </div>
      <div id="__icons_header"></div>
      <div class="icons-container" id="__icons_container"></div>
    `;

    const input = document.getElementById("__icons_input_query") as HTMLInputElement;
    const clearButton = document.getElementById("clear_search") as HTMLButtonElement;
    const iconsContainer = document.getElementById("__icons_container") as HTMLElement;
    const iconsHeader = document.getElementById("__icons_header") as HTMLElement;

    const showIconResults = (query = "") => {
      const filteredIcons = query.trim() !== "" 
        ? icons.filter(icon => {
            const nameLowered = icon.code.trim().toLowerCase();
            const queryLowered = query.trim().toLowerCase();
            return nameLowered.includes(queryLowered) || nameLowered.replace(/ /g, "").includes(queryLowered.replace(/ /g, ""));
          }) 
        : icons;

      iconsContainer.innerHTML = "";
      iconsHeader.innerHTML = "";

      if (filteredIcons.length === 0) {
        iconsHeader.innerHTML = `<p class="note">لا توجد أي نتائج...</p>`;
      } else {
        filteredIcons.forEach((icon) => {
          const button = document.createElement("button");
          button.className = "icon-box";
          button.type = "button";
          button.innerHTML = `${icon.svg}<span>${icon.code}</span>`;
          
          button.addEventListener("click", () => {
            navigator.clipboard.writeText(icon.svg)
              .then(() => toastNotif(`تم نسخ: ${icon.code}`))
              .catch(() => toastNotif(`فشل النسخ!`));
          });
          iconsContainer.appendChild(button);
        });
      }
    };

    input.addEventListener("input", (e) => {
      const query = (e.target as HTMLInputElement).value;
      showIconResults(query);
      clearButton.style.display = query.length > 0 ? "block" : "none";
    });

    clearButton.addEventListener("click", () => {
      input.value = "";
      clearButton.style.display = "none";
      showIconResults("");
    });

    showIconResults();
  };

  const init = async () => {
    const target = document.getElementById("__icons");
    if (!target) return;

    try {
      const response = await fetch("https://cdn.jsdelivr.net/gh/alicomputer7/919-icon-svg@latest/919%20icon%20svg.txt");
      if (response.ok) {
        const icons = await response.json();
        renderUI(target, icons);
      } else {
        target.innerHTML = "<p>فشل تحميل الأيقونات.</p>";
      }
    } catch (error) {
      console.error("Error fetching icons:", error);
      target.innerHTML = "<p>حدث خطأ أثناء التحميل.</p>";
    }
  };

  // تشغيل الكود عند تحميل الصفحة في Astro
  init();
</script>
