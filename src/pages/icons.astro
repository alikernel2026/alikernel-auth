---
// ملاحظة هامة: تأكد من حفظ هذا الملف بصيغة UTF-8 في محرر الأكواد (VS Code)
---

<div class='tNtf alt' id='toastNotif'></div>

<div id="__icons" class="icons-wrapper" dir="rtl">
  <div class="loading-note">يتم تحميل الأيقونه. الرجاء الانتظار..</div>
</div>

<style is:global>
  /* إجبار الخط العربي ومنع تشفير الحروف */
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;700&display=swap');

  :root {
    --headerBg: #111111;
    --sideBd-color: #333333;
    --inputC: #ffffff;
    --themeLink: #4ade80;
    --contentBg-sec: #1a1a1a;
    --buttonBd-color: #444444;
  }

  .__icons_container_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 10px;
    padding: 15px 0;
    counter-reset: num-icon;
  }

  .icon-box-item {
    counter-increment: num-icon;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--sideBd-color);
    border-radius: 7px;
    background-color: var(--headerBg);
    color: var(--inputC);
    padding: 10px;
    cursor: pointer;
    transition: 0.2s;
    outline: none;
  }

  .icon-box-item::before {
    content: counter(num-icon);
    position: absolute;
    top: 5px;
    left: 5px;
    font-size: 10px;
    border-radius: 4px;
    padding: 0 4px;
    border: 1px solid var(--buttonBd-color);
    background-color: var(--contentBg-sec);
    color: #999;
  }

  .icon-box-item svg {
    width: 35px;
    height: 35px;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.5;
  }

  .icon-box-item span {
    display: block;
    font-size: 11px;
    margin-top: 10px;
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 90%;
  }

  .icon-box-item:hover {
    border-color: var(--themeLink) !important;
    box-shadow: 0 0 0 0.5px var(--themeLink) inset;
  }

  .icons-search-input {
    width: 100%;
    padding: 18px;
    background: var(--headerBg);
    border: 1px solid var(--sideBd-color);
    border-radius: 8px;
    color: var(--inputC);
    font-family: 'Noto Sans Arabic', sans-serif;
    margin-bottom: 10px;
  }

  /* التوست الأصلي */
  .tNtf {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 9999;
    background: #ffffff;
    color: #111111;
    padding: 12px 20px;
    border-radius: 8px;
    display: none;
    font-family: 'Noto Sans Arabic', sans-serif;
    box-shadow: 0 5px 20px rgba(0,0,0,0.3);
  }
</style>

<script>
  // دالة التوست الأصلية
  function toastNotif(text: string) {
    const n = document.getElementById('toastNotif');
    if (n) {
      n.innerHTML = `<span>${text}</span>`;
      n.style.display = 'block';
      setTimeout(() => { n.style.display = 'none'; }, 3000);
    }
  }

  const initIconPicker = async () => {
    const wrapper = document.getElementById("__icons");
    if (!wrapper) return;

    try {
      const res = await fetch("https://cdn.jsdelivr.net/gh/alicomputer7/919-icon-svg@latest/919%20icon%20svg.txt");
      const icons = await res.json();

      wrapper.innerHTML = `
        <p style="color:#888; font-size:13px; margin-bottom:10px;">انقر على الأيقونة لنسخ كود SVG الخاص بها.</p>
        <input type="text" id="iconSearch" class="icons-search-input" placeholder="ابحث بين ${icons.length} أيقونة..." />
        <div id="iconsGrid" class="__icons_container_grid"></div>
      `;

      const grid = document.getElementById("iconsGrid")!;
      const search = document.getElementById("iconSearch") as HTMLInputElement;

      const render = (query = "") => {
        const q = query.toLowerCase().trim();
        const filtered = icons.filter((i: any) => i.code.toLowerCase().includes(q));
        
        grid.innerHTML = filtered.map((icon: any) => `
          <button class="icon-box-item" type="button" data-svg='${icon.svg.replace(/'/g, "&apos;")}'>
            ${icon.svg}
            <span>${icon.code}</span>
          </button>
        `).join('');

        grid.querySelectorAll('.icon-box-item').forEach(btn => {
          btn.addEventListener('click', () => {
            const svg = btn.getAttribute('data-svg')!;
            const name = btn.querySelector('span')!.innerText;
            navigator.clipboard.writeText(svg);
            toastNotif(`تم نسخ: ${name}`);
          });
        });
      };

      search.addEventListener("input", (e) => render((e.target as HTMLInputElement).value));
      render();

    } catch (e) {
      wrapper.innerHTML = "خطأ في تحميل البيانات.";
    }
  };

  initIconPicker();
</script>
