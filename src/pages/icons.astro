---
// تأكد من حفظ الملف بصيغة UTF-8 لضمان ظهور اللغة العربية بشكل سليم
---

<div class='tNtf alt' id='toastNotif'></div>

<div id="__icons" class="icons-wrapper" dir="rtl">
  <p class='note'>يتم تحميل الأيقونه. الرجاء الانتظار..</p>
</div>

<style is:global>
  /* تنسيق التوست (tNtf) ليعمل في أسترو كما في بلوجر */
  .tNtf {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 9999;
    background: #fff;
    color: #333;
    padding: 12px 20px;
    border-radius: 8px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    display: none; /* يظهر فقط عند النسخ */
    font-size: 14px;
    font-family: inherit;
  }
  .tNtf span { display: flex; align-items: center; gap: 8px; }

  /* تنسيق الأيقونات (نفس كودك الأصلي مع إصلاحات العرض) */
  .icons-container {
    counter-reset: num-icon;
    display: grid;
    /* 8 أعمدة كما طلبت */
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 10px;
    padding: 10px 0;
  }

  .icons-container > * {
    counter-increment: num-icon;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border: var(--sideBd-line, 1px) solid var(--sideBd-color, #333);
    border-radius: 7px;
    overflow: hidden;
    background-color: var(--headerBg, #111);
    color: var(--inputC, #eee);
    padding: 10px;
    cursor: pointer;
    border-style: solid;
  }

  .icons-container > *::before {
    content: counter(num-icon);
    position: absolute;
    top: 5px;
    left: 5px;
    font-size: 10px;
    border-radius: 4px;
    padding: 0 3px;
    border: var(--buttonBd-line, 1px) solid var(--buttonBd-color, #444);
    background-color: var(--contentBg-sec, #222);
  }

  /* إصلاح ظهور الأيقونات (Linear) ومنع السواد */
  .icons-container > * svg {
    width: 35px;
    height: 35px;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.5;
  }

  .icons-container > * span {
    display: block;
    font-size: 11px;
    text-align: center;
    margin-top: 8px;
    opacity: .8;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 90%;
  }

  .icons-container > *:hover {
    border-color: var(--themeLink, #4ade80) !important;
    box-shadow: 0 0 0 0.5px var(--themeLink, #4ade80) inset;
  }

  .icons-input {
    border: var(--sideBd-line, 1px) solid var(--sideBd-color, #333);
    border-radius: 7px;
    background-color: var(--headerBg, #111);
    color: var(--inputC, #fff);
    width: 100%;
    margin-bottom: 10px;
    padding: 20px;
    outline: 0;
  }
</style>

<script>
  // 1. دالة التوست الأصلية الخاصة بك كما هي
  function toastNotif(t: string) {
    var n = document.getElementById('toastNotif');
    if (n != null) {
      n.innerHTML = "<span>" + t + "</span>";
      n.style.display = 'block';
      setTimeout(function() { n!.style.display = 'none'; }, 3000);
    }
  }

  const renderUI = (target: HTMLElement, icons: any[]) => {
    target.innerHTML = `
      <p class="note">انقر على الأيقونة لنسخ كود SVG الخاص بها.</p>
      <div style="position: relative; display: flex; align-items: center;">
        <input placeholder="ابحث بين ${icons.length} أيقونه..." class="icons-input" id="__icons_input_query" type="text" style="width: 100%;"/>
      </div>
      <div id="__icons_header"></div>
      <div class="icons-container" id="__icons_container"></div>
    `;

    const input = document.getElementById("__icons_input_query") as HTMLInputElement;
    const iconsContainer = document.getElementById("__icons_container") as HTMLElement;

    const showIconResults = (query = "") => {
      const q = query.trim().toLowerCase();
      const filteredIcons = q !== "" 
        ? icons.filter(icon => icon.code.toLowerCase().includes(q)) 
        : icons;

      iconsContainer.innerHTML = "";
      filteredIcons.forEach((icon) => {
        const button = document.createElement("button");
        button.className = "icon-box";
        button.type = "button";
        button.innerHTML = `${icon.svg}<span>${icon.code}</span>`;
        
        button.addEventListener("click", () => {
          navigator.clipboard.writeText(icon.svg)
            .then(() => {
              // استخدام دالة التوست الأصلية الخاصة بك
              toastNotif(`تم نسخ: ${icon.code}`);
            })
            .catch(() => toastNotif(`فشل النسخ!`));
        });
        iconsContainer.appendChild(button);
      });
    };

    input.addEventListener("input", (e) => {
      showIconResults((e.target as HTMLInputElement).value);
    });

    showIconResults();
  };

  // جلب البيانات من الرابط
  const init = async () => {
    const wrapper = document.getElementById("__icons");
    if (!wrapper) return;
    try {
      const res = await fetch("https://cdn.jsdelivr.net/gh/alicomputer7/919-icon-svg@latest/919%20icon%20svg.txt");
      const icons = await res.json();
      renderUI(wrapper, icons);
    } catch (e) {
      console.error("Fetch error:", e);
    }
  };

  init();
</script>
