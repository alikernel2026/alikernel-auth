---
// تأكد أن الصفحة التي تستدعي هذا المكون تحتوي على <meta charset="utf-8" />
---

<div id="__icons" class="icons-wrapper" dir="rtl">
  <p class='note'>جاري تحميل الأيقونات...</p>
</div>

<style is:global>
  /* إجبار الصفحة على دعم العربية */
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;700&display=swap');

  :root {
    /* ألوان افتراضية في حال لم تكن معرفة في قالبك */
    --headerBg: #1a1a1a;
    --sideBd-color: #333;
    --inputC: #eee;
    --themeLink: #007bff;
    --contentBg-sec: #222;
    --buttonBd-color: #444;
  }

  .icons-wrapper {
    font-family: 'Noto Sans Arabic', sans-serif;
    color: var(--inputC, #fff);
  }

  .icons-container {
    counter-reset: num-icon;
    display: grid;
    /* تأمين 8 أعمدة أو حسب مساحة الشاشة */
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 15px;
    padding: 20px 0;
  }

  /* تنسيق المربع (الزر) */
  .icons-container > button.icon-box {
    counter-increment: num-icon;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--sideBd-color, #333);
    border-radius: 10px;
    background-color: var(--headerBg, #1a1a1a);
    color: var(--inputC, #fff);
    padding: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    outline: none;
  }

  /* الرقم الصغير فوق */
  .icons-container > button.icon-box::before {
    content: counter(num-icon);
    position: absolute;
    top: 8px;
    left: 8px;
    font-size: 10px;
    background: var(--contentBg-sec, #222);
    border: 1px solid var(--buttonBd-color, #444);
    padding: 2px 5px;
    border-radius: 4px;
    line-height: 1;
  }

  /* اسم الأيقونة */
  .icons-container > button.icon-box span {
    margin-top: 10px;
    font-size: 11px;
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* الأيقونة نفسها - Stroke */
  .icons-container > button.icon-box svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icons-container > button.icon-box:hover {
    border-color: var(--themeLink, #007bff) !important;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
  }

  /* حقل البحث */
  .icons-input {
    width: 100%;
    padding: 15px 20px;
    background: var(--headerBg, #1a1a1a);
    border: 1px solid var(--sideBd-color, #333);
    border-radius: 8px;
    color: var(--inputC, #fff);
    font-size: 15px;
    margin-top: 10px;
    outline: none;
  }

  .icons-input:focus {
    border-color: var(--themeLink, #007bff);
  }

  /* التوست */
  #toastNotif {
    position: fixed;
    bottom: 20px;
    left: 20px;
    background: #fff;
    color: #111;
    padding: 10px 20px;
    border-radius: 5px;
    font-weight: bold;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    z-index: 10000;
    display: none;
    animation: slideUp 0.3s ease;
  }

  @keyframes slideUp {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>

<script>
  const toastNotif = (msg: string) => {
    let toast = document.getElementById('toastNotif');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'toastNotif';
      document.body.appendChild(toast);
    }
    toast.innerText = msg;
    toast.style.display = 'block';
    setTimeout(() => { if(toast) toast.style.display = 'none'; }, 2500);
  };

  const renderUI = (target: HTMLElement, icons: any[]) => {
    target.innerHTML = `
      <p class="note" style="margin-bottom:10px; opacity:0.7;">انقر على الأيقونة لنسخ كود SVG الخاص بها.</p>
      <div style="position: relative; margin-bottom:20px;">
        <input placeholder="ابحث بين ${icons.length} أيقونة..." class="icons-input" id="__icons_input_query" type="text" />
      </div>
      <div id="__icons_container" class="icons-container"></div>
    `;

    const input = document.getElementById("__icons_input_query") as HTMLInputElement;
    const container = document.getElementById("__icons_container") as HTMLElement;

    const filterIcons = (query = "") => {
      const q = query.toLowerCase().trim();
      const filtered = icons.filter(i => i.code.toLowerCase().includes(q));
      
      container.innerHTML = filtered.map(icon => `
        <button class="icon-box" type="button" data-svg='${icon.svg.replace(/'/g, "&apos;")}'>
          ${icon.svg}
          <span>${icon.code}</span>
        </button>
      `).join('');

      // إضافة حدث النسخ
      container.querySelectorAll('.icon-box').forEach(btn => {
        btn.addEventListener('click', () => {
          const svg = btn.getAttribute('data-svg');
          const name = btn.querySelector('span')?.innerText;
          if (svg) {
            navigator.clipboard.writeText(svg);
            toastNotif(`تم نسخ: ${name}`);
          }
        });
      });
    };

    input.addEventListener("input", (e) => filterIcons((e.target as HTMLInputElement).value));
    filterIcons();
  };

  const init = async () => {
    const wrapper = document.getElementById("__icons");
    if (!wrapper) return;
    try {
      const res = await fetch("https://cdn.jsdelivr.net/gh/alicomputer7/919-icon-svg@latest/919%20icon%20svg.txt");
      const data = await res.json();
      renderUI(wrapper, data);
    } catch (e) {
      wrapper.innerHTML = "حدث خطأ في تحميل البيانات.";
    }
  };

  init();
</script>
