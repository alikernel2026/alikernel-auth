<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>اتفاقية نقل المحتوى - علي كيرنل</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <style is:global>
        :root {
            --fontBody: 'Noto Sans', 'Tajawal', sans-serif;
            --sideBd-line: 1px;
            --content-maxWidth: 1024px;
            --contentPadding: 22px;
        }
        body {
            --themeBg: #100f10;
            --postBg: #1b1b1b;
            --headerBg: #1b1b1b;
            --contentBg-sec: #252526;
            --themeLink: #94f27f;
            --themeC: #d9e2f0;
            --themeC-alt: #a0a0a0;
            --sideBd-color: #3a3c3d;
            --alikernelBg: #ffffff;
            --alikernelC: #171717;
        }
        body[data-theme="light"] {
            --themeBg: #f6f8fa;
            --postBg: #ffffff;
            --headerBg: #ffffff;
            --contentBg-sec: #f5f3f2;
            --themeLink: #1976d2;
            --themeC: #0e2045;
            --themeC-alt: #666666;
            --sideBd-color: #d2d3d7;
            --alikernelBg: #171717;
            --alikernelC: #ffffff;
        }
        @media (prefers-color-scheme: dark) {
            body[data-theme="default"] {
                --themeBg: #100f10;
                --postBg: #1b1b1b;
                --headerBg: #1b1b1b;
                --contentBg-sec: #252526;
                --themeLink: #94f27f;
                --themeC: #d9e2f0;
                --themeC-alt: #a0a0a0;
                --sideBd-color: #3a3c3d;
                --alikernelBg: #ffffff;
                --alikernelC: #171717;
            }
        }
        @media (prefers-color-scheme: light) {
            body[data-theme="default"] {
                --themeBg: #f6f8fa;
                --postBg: #ffffff;
                --headerBg: #ffffff;
                --contentBg-sec: #f5f3f2;
                --themeLink: #1976d2;
                --themeC: #0e2045;
                --themeC-alt: #666666;
                --sideBd-color: #d2d3d7;
                --alikernelBg: #171717;
                --alikernelC: #ffffff;
            }
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--fontBody);
            background-color: var(--themeBg);
            color: var(--themeC);
            min-height: 100vh;
            line-height: 1.6;
        }
        a { text-decoration: none; color: inherit; }
        button { font-family: inherit; cursor: pointer; border: none; background: none; }
        .page-wrapper { min-height: 100vh; display: flex; flex-direction: column; }

        /* Header */
        .site-header {
            position: sticky; top: 0; z-index: 100;
            display: flex; align-items: center; justify-content: center;
            height: 65px;
            border-bottom: 1px solid var(--sideBd-color);
            background-color: oklch(0.25 0 0 / 0.4);
            -webkit-backdrop-filter: blur(8px);
            backdrop-filter: blur(8px);
        }
        body[data-theme="light"] .site-header { background-color: rgba(255,255,255,0.4); }
        @media (prefers-color-scheme: light) {
            body[data-theme="default"] .site-header { background-color: rgba(255,255,255,0.4); }
        }
        .header-content {
            width: 100%; max-width: var(--content-maxWidth);
            margin-inline: auto; padding-inline: var(--contentPadding);
            display: flex; align-items: center; justify-content: flex-start;
        }
        .header-logo-link {
            display: flex; align-items: center; gap: 12px;
            color: var(--themeC); font-weight: 700; font-size: 18px;
        }
        .header-logo-link a { color: var(--themeC); }
        .header-logo-icon { width: 32px; height: 32px; }

        /* Page content */
        .page-content { flex: 1; }
        .static-page-content {
            max-width: 820px;
            margin: 0 auto;
            padding: 40px var(--contentPadding);
            line-height: 1.9;
        }
        .static-page-content h1 {
            font-size: 26px; font-weight: 700;
            margin-bottom: 30px; padding-bottom: 15px;
            border-bottom: 1px solid var(--sideBd-color);
            color: var(--themeC);
        }
        .static-page-content h2 {
            font-size: 17px; font-weight: 700;
            margin-top: 32px; margin-bottom: 10px;
            color: var(--themeC);
        }
        .static-page-content p {
            font-size: 15px; color: var(--themeC-alt);
            margin-bottom: 12px; text-align: justify;
        }
        .static-page-content a { color: var(--themeLink); }
        .static-page-content ul {
            padding-right: 20px; margin-bottom: 12px;
        }
        .static-page-content ul li {
            font-size: 15px; color: var(--themeC-alt);
            margin-bottom: 8px; text-align: justify;
        }
        .static-page-content strong { color: var(--themeC); }

        /* Footer */
        .site-footer {
            border-top: 1px solid var(--sideBd-color);
            padding-block: 25px;
            background-color: var(--headerBg);
            margin-top: auto;
        }
        .footer-content {
            max-width: var(--content-maxWidth);
            margin-inline: auto; padding-inline: var(--contentPadding);
            display: flex; justify-content: space-between; align-items: center;
        }
        .footer-logo-section { display: flex; align-items: center; gap: 8px; }
        .footer-logo-link {
            display: flex; align-items: center; gap: 6px;
            color: var(--themeC); font-weight: 700; font-size: 14px;
        }
        .footer-logo-icon { width: 28px; height: 28px; }
        .footer-logo-section a:not(.footer-logo-link) { font-size: 12px; opacity: .85; }
        .footer-logo-section a:not(.footer-logo-link):hover { text-decoration: underline; }

        /* Theme Controls */
        .theme-controls {
            display: flex; border: 1px solid var(--sideBd-color);
            border-radius: 9px; overflow: visible;
            background-color: var(--alikernelC);
        }
        .theme-btn {
            position: relative; padding: 8px 9px;
            display: flex; align-items: center; justify-content: center;
            background-color: transparent; color: var(--themeC-alt);
            cursor: pointer; transition: all 0.2s;
        }
        .theme-btn:first-child { border-radius: 0 8px 8px 0; }
        .theme-btn:last-child { border-radius: 8px 0 0 8px; }
        .theme-btn:not(:last-child) { border-left: 1px solid var(--sideBd-color); }
        .theme-btn:hover { color: var(--alikernelBg); }
        .theme-btn.active { background-color: var(--contentBg-sec); }
        .theme-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; }
        @keyframes slideUp {
            0% { opacity: 0; transform: translateX(-50%) translateY(10px); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0); }
        }
        .theme-btn .tooltip-box {
            position: absolute; bottom: 100%; left: 50%;
            transform: translateX(-50%); margin-bottom: 10px;
            background-color: var(--alikernelBg); color: var(--alikernelC);
            padding: 6px 12px; border-radius: 6px;
            font-size: 12px; font-weight: 600; white-space: nowrap;
            opacity: 0; visibility: hidden; pointer-events: none; z-index: 20;
        }
        .theme-btn .tooltip-arrow {
            position: absolute; bottom: 0; left: 50%;
            transform: translateX(-50%) translateY(30%) rotate(45deg);
            width: 10px; height: 10px;
            background-color: var(--alikernelBg); border-radius: 2px;
        }
        .theme-btn:hover .tooltip-box { visibility: visible; animation: slideUp 0.2s ease-out forwards; }
        ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
        ::view-transition-new(root) { z-index: 2; }

        @media (max-width: 768px) {
            .footer-content { flex-direction: column; gap: 15px; }
        }
    </style>
</head>
<body id="nB" class="nB">
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('theme') || 'default';
            document.body.setAttribute('data-theme', theme);
        })();
        window.addEventListener('storage', function(e) {
            if (e.key === 'theme' && e.newValue) {
                document.body.setAttribute('data-theme', e.newValue);
            }
        });
    </script>

    <div class="page-wrapper">
        <header class="site-header">
            <div class="header-content">
                <a href="https://www.alikernel.com" class="header-logo-link">
                    <svg class="header-logo-icon" viewBox="0 0 124 124" fill="none">
                        <rect width="124" height="124" rx="24" fill="#F97316"/>
                        <path d="M19.375 36.782v63.843a4 4 0 0 0 4 4h63.843c3.564 0 5.348-4.309 2.829-6.828L26.203 33.953c-2.52-2.52-6.828-.735-6.828 2.829" fill="#fff"/>
                        <circle cx="63.211" cy="37.539" r="18.164" fill="#000"/>
                        <rect opacity=".4" x="81.133" y="80.72" width="17.569" height="17.388" rx="4" transform="rotate(-45 81.133 80.72)" fill="#FDBA74"/>
                    </svg>
                    <a href="https://www.alikernel.com">علي كيرنل</a>
                </a>
            </div>
        </header>

        <main class="page-content">
            
<div class="static-page-content">
        <h1>اتفاقية نقل المحتوى</h1>
        <p>هي عبارة عن حلقة الوصل بيني وبين من يريد أن يقوم بنسخ أو نقل موضوع من الموقع. أنت الآن تريد أن تقوم بنسخ موضوع ووضعه في موقعك أو مدونة خاصة بك، لنجعل بيننا اتفاق.</p>
        <p>أنت تريد عمل هذا ولكن هناك شروط. أنت تعلم أن أمر كتابة المواضيع مرهق وخاصة أنه قد يأخذ أياماً لتحضيره من جمع معلومات والتأكد منها وتجربتها. لذلك يجب عليك ألا تقوم بنسخ المحتوى مراعاةً للمجهود الذي تم بذله.</p>
        <p>نحن نرحب بكل عمل أساسه هو زيادة المعرفة والمحتوى العربي، ولكن هناك شروط وقواعد يجب عليك مراعاتها حتى لا تكون سارقاً للمحتوى.</p>
        <h2>شروط اتفاقية نقل ونشر المحتوى</h2>
        <ul>
            <li>عدم التعديل على أي نص في الموضوع نهائياً، يجب نقله كما هو موجود.</li>
            <li>يجب عليك في نهاية التدوينة ذكر المصدر الأصلي للتدوينة وعدم حذفه نهائياً.</li>
            <li>عدم التعديل على الصور الخاصة بالتدوينة أو الفيديوهات.</li>
            <li>يجب أن تكون كتابة المصدر واضحة وظاهرة لقراء الموقع.</li>
        </ul>
        <h2>كيفية كتابة المصدر</h2>
        <p>المصدر الأصلي: <a href="https://www.alikernel.com">علي كيرنل</a></p>
        <p>رابط الموضوع الأصلي: تضع هنا رابط الموضوع</p>
        <h2>ماذا إذا لم تلتفت لهذه الاتفاقية</h2>
        <ul>
            <li>أولاً سيتم إرسال طلب حذف الموضوع نهائياً.</li>
            <li>إذا لم تلتفت لطلب الموقع سيتم تقديم رسالة <strong>DMCA</strong> لمستضيفك لحذف الصفحات وتقديم تحذير لك.</li>
            <li>إذا لم تلتفت ولم يتعاون مستضيفك سيتم إرسال شكوى لجوجل بحذف موقعك من بحث الويب.</li>
        </ul>
        <h2>المحتوى على الإنترنت ليس للنقل</h2>
        <p><strong>DMCA</strong> هي اختصار لـ <strong>Digital Millennium Copyright Act</strong> قانون حق المؤلف للألفية الرقمية، وهو قانون لحماية الحقوق الفكرية بالولايات المتحدة. صدر هذا القانون في 12 أكتوبر 1998 بعدما حصل على تصويت بالإجماع من مجلس الشيوخ الأمريكي.</p>
        <p style="text-align:center; margin-top: 30px;">شكراً لتفهمكم / فريق عمل علي كيرنل</p>
    </div>

        </main>

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-logo-section">
                    <a href="https://www.alikernel.com" class="footer-logo-link">
                        <svg class="footer-logo-icon" viewBox="0 0 124 124" fill="none">
                            <rect width="124" height="124" rx="24" fill="#F97316"/>
                            <path d="M19.375 36.782v63.843a4 4 0 0 0 4 4h63.843c3.564 0 5.348-4.309 2.829-6.828L26.203 33.953c-2.52-2.52-6.828-.735-6.828 2.829" fill="#fff"/>
                            <circle cx="63.211" cy="37.539" r="18.164" fill="#000"/>
                            <rect opacity=".4" x="81.133" y="80.72" width="17.569" height="17.388" rx="4" transform="rotate(-45 81.133 80.72)" fill="#FDBA74"/>
                        </svg>
                        <span>علي كيرنل</span>
                    </a>
                    <a href="/privacy">الخصوصية</a>
                    <a href="/terms">الشروط</a>
                </div>
                <div class="theme-controls">
                    <button class="theme-btn" id="theme-btn-dark" onclick="setTheme('dark', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M19 3v4"/><path d="M21 5h-4"/></svg>
                        <div class="tooltip-box">مظلم<div class="tooltip-arrow"></div></div>
                    </button>
                    <button class="theme-btn" id="theme-btn-light" onclick="setTheme('light', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                        <div class="tooltip-box">نهار<div class="tooltip-arrow"></div></div>
                    </button>
                    <button class="theme-btn" id="theme-btn-system" onclick="setTheme('default', true)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        <div class="tooltip-box">تلقائي<div class="tooltip-arrow"></div></div>
                    </button>
                </div>
            </div>
        </footer>
    </div>

    <script is:inline>
    function setTheme(theme, animate) {
        function applyTheme() {
            document.body.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
            document.querySelectorAll('.theme-btn').forEach(function(btn) { btn.classList.remove('active'); });
            if (theme === 'dark') document.getElementById('theme-btn-dark').classList.add('active');
            else if (theme === 'light') document.getElementById('theme-btn-light').classList.add('active');
            else document.getElementById('theme-btn-system').classList.add('active');
        }
        if (!animate || !document.startViewTransition) { applyTheme(); return; }
        try {
            var btn = document.activeElement;
            var x = window.innerWidth/2, y = window.innerHeight/2;
            if (btn && btn.classList && btn.classList.contains('theme-btn')) {
                var r = btn.getBoundingClientRect();
                x = r.left + r.width/2; y = r.top + r.height/2;
            }
            var radius = Math.hypot(Math.max(x, window.innerWidth-x), Math.max(y, window.innerHeight-y));
            var transition = document.startViewTransition(applyTheme);
            transition.ready.then(function() {
                document.documentElement.animate(
                    { clipPath: ['circle(0px at '+x+'px '+y+'px)', 'circle('+radius+'px at '+x+'px '+y+'px)'] },
                    { duration: 800, easing: 'ease-out', pseudoElement: '::view-transition-new(root)' }
                );
            });
        } catch(e) { applyTheme(); }
    }
    var savedTheme = localStorage.getItem('theme') || 'default';
    setTheme(savedTheme, false);
    </script>
</body>
</html>
